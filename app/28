var APERM_PERFIS_DE_HOJE = [
  ["admin","Administrador","*"],
  ["gestor","Gestor",["dashboard","estoque","reservas","aprovacoes","relatorios","epi","nf","ocorrencias","compras","ferramentas","lojinha"]],
