/* ============================================================
   ALMOX-PRO · INVENTÁRIO MÓVEL POR ENDEREÇO   ·  AP_INVENTARIO.gs
   14/11/2026  ·  fase 4 do ALMOXA 3D V2, seções 7, 8, 9 e 12
   ------------------------------------------------------------
   POR QUE ESTE ARQUIVO EXISTE

   A fase 4 pede coisa que o Core não tem: atividade de inventário
   atribuída a um funcionário, validação do QR contra o endereço
   esperado, contagem física com divergência e linha do tempo por
   posição e por funcionário. Eu procurei nos módulos que o
   ALMOX PRO chama hoje e não existe nenhum deles.

   O QUE EU NÃO FIZ, DE PROPÓSITO

   · NÃO me chamo "inventario". Esse módulo JÁ EXISTE no seu Core
     (listar, contar, divergencias, sugestoes) e cinco telas do
     sistema dependem dele. Publicar um AP_Modulo_inventario aqui
     atropelaria o seu. Este módulo se chama "invmovel".
   · NÃO me chamo "atividades". Esse também já existe.
   · NÃO uso a aba ALMOXA_ATIVIDADES (6 linhas) nem a
     ALMOXA_INVENTARIOS. Elas são dos módulos que já existem. Pegar
     aba de outro módulo emprestada é como gravar na gaveta alheia.
   · NÃO crio aba sozinho. Em operação normal este arquivo só lê e
     grava no que já existe. Para criar as abas há uma função
     separada, AP_INV_INSTALAR, que o senhor roda sabendo o que
     está fazendo, e que diz exatamente o que criou.
   · NÃO apago linha. Nunca. Cancelar é status.
   · NÃO mexo no saldo do estoque. A seção 9 é clara: "Uma contagem
     não deverá alterar automaticamente o saldo oficial sem a
     autorização exigida pelo Core."
   · NÃO acredito no navegador. Quem é o usuário e o que ele pode
     fazer é decidido aqui, pela sessão, como manda a seção 12.

   AS TRÊS ABAS QUE ELE USA
     ALMOXA_INV_ATIVIDADES  — uma linha por atividade
     ALMOXA_INV_CONTAGENS   — uma linha por posição conferida
     ALMOXA_INV_EVENTOS     — a linha do tempo, seção 8

   COMO INSTALAR
     1. Cole este arquivo no projeto do Apps Script (Script, não HTML).
     2. Rode AP_INV_DIAGNOSTICO  → ele diz o que falta.
     3. Rode AP_INV_INSTALAR     → cria só o que falta, e informa.
        Se der erro, rode AP_INV_DIAGNOSTICO_INSTALACAO() — ela só
        lê, e diz a causa com nome de função e etapa.
     4. Publique nova versão.
   ============================================================ */

var AP_INV_CFG = {
  abaAtividades: 'ALMOXA_INV_ATIVIDADES',
  abaContagens:  'ALMOXA_INV_CONTAGENS',
  abaEventos:    'ALMOXA_INV_EVENTOS',
  abaRotas:      'ALMOXA_INV_ROTAS',

  /* [módulo 01 · 15/11] 'deposito' e 'prioridade' entram no fim: a
     instalação acrescenta coluna que falta sem mexer na ordem do
     que já existe, então nenhuma planilha em uso quebra. */
  colunasAtividades: ['id', 'tipo', 'galpao', 'rua', 'estante', 'prateleira',
    'posicoes', 'quantasPosicoes', 'responsavel', 'responsavelId', 'prazo',
    'instrucoes', 'status', 'criadaPor', 'criadaEm', 'iniciadaEm',
    'concluidaEm', 'confirmadaPor', 'observacao', 'deposito', 'prioridade'],

  /* 'rotaId' também entra no fim, pelo mesmo motivo */
  colunasContagens: ['id', 'atividadeId', 'codigo', 'rua', 'estante',
    'prateleira', 'posicao', 'qrLido', 'saldoSistema', 'qtdEncontrada',
    'diferenca', 'resultado', 'observacao', 'ocorrencia', 'fotos',
    'quem', 'quemId', 'quando', 'operacaoId', 'sessaoId', 'status', 'rotaId'],

  /* A ROTA é um recorte da atividade: um punhado das posições dela,
     em ordem, com um dono. NÃO guarda cadastro de material — isso
     seria banco paralelo. O campo 'materiais' é um FILTRO opcional:
     os códigos que o gestor quer que sejam conferidos naquele local.
     A descrição, a unidade e o saldo continuam vindo do Core. */
  colunasRotas: ['id', 'atividadeId', 'nome', 'ordem', 'deposito', 'rua',
    'descricao', 'responsavel', 'responsavelId', 'posicoes', 'quantasPosicoes',
    'materiais', 'prioridade', 'prazo', 'status', 'criadaEm', 'criadaPor',
    'iniciadaEm', 'concluidaEm', 'observacao'],

  /* os estados que a seção 4 do prompt pede, nessa ordem */
  statusRota: ['NOVA', 'AGUARDANDO_INICIO', 'EM_ANDAMENTO', 'PENDENTE',
    'COM_DIVERGENCIA', 'AGUARDANDO_APROVACAO', 'CONCLUIDA', 'CANCELADA'],

  prioridades: ['BAIXA', 'NORMAL', 'ALTA', 'URGENTE'],

  colunasEventos: ['id', 'quando', 'atividadeId', 'codigo', 'quem', 'quemId',
    'evento', 'detalhe'],

  /* seção 7, etapa 4: os resultados possíveis de uma conferência.
     Nenhum deles é inventado na hora — a lista é fechada. */
  resultados: ['CONFERIDO', 'DIVERGENCIA_POSITIVA', 'DIVERGENCIA_NEGATIVA',
    'MATERIAL_NAO_CADASTRADO', 'MATERIAL_ENDERECO_INCORRETO', 'POSICAO_VAZIA',
    'POSICAO_BLOQUEADA', 'MATERIAL_DANIFICADO', 'SEM_SALDO_PARA_COMPARAR'],

  tipos: ['COMPLETO', 'ROTATIVO', 'RUA', 'ESTANTE', 'PRATELEIRA', 'POSICAO'],

  statusAtividade: ['ABERTA', 'EM_EXECUCAO', 'CONCLUIDA', 'CONFIRMADA', 'CANCELADA'],

  tetoLeitura: 20000,
  /* o prefixo do QR que o mapa 3D já imprime nas etiquetas */
  prefixoQr: 'ALMOXA:LOC:'
};


/* ============================================================
   1. FERRAMENTA MIÚDA
   ============================================================ */

function AP_INV_txt_(v) { return v == null ? '' : String(v).trim(); }

function AP_INV_num_(v) {
  if (v === '' || v === null || v === undefined) return null;
  if (typeof v === 'number') return isFinite(v) ? v : null;
  var t = String(v).trim().replace(/\s/g, '');
  if (!t) return null;
  if (t.indexOf(',') > -1 && t.indexOf('.') > -1) t = t.replace(/\./g, '').replace(',', '.');
  else if (t.indexOf(',') > -1) t = t.replace(',', '.');
  var n = Number(t);
  return isFinite(n) ? n : null;
}

function AP_INV_normal_(v) {
  return AP_INV_txt_(v).toUpperCase()
    .replace(/[ÁÀÂÃÄ]/g, 'A').replace(/[ÉÈÊË]/g, 'E').replace(/[ÍÌÎÏ]/g, 'I')
    .replace(/[ÓÒÔÕÖ]/g, 'O').replace(/[ÚÙÛÜ]/g, 'U').replace(/Ç/g, 'C')
    .replace(/[^A-Z0-9]/g, '');
}

function AP_INV_agora_() {
  try {
    return Utilities.formatDate(new Date(), Session.getScriptTimeZone(),
      'yyyy-MM-dd HH:mm:ss');
  } catch (e) { return new Date().toISOString(); }
}

function AP_INV_planilha_() {
  try { return SpreadsheetApp.getActive(); } catch (e) { return null; }
}

function AP_INV_ok_(dados, extra) {
  var r = { ok: true, dados: dados };
  if (extra) for (var k in extra) if (extra.hasOwnProperty(k)) r[k] = extra[k];
  return r;
}

function AP_INV_erro_(codigo, mensagem, extra) {
  var r = { ok: false, codigo: codigo, mensagem: mensagem };
  if (extra) for (var k in extra) if (extra.hasOwnProperty(k)) r[k] = extra[k];
  return r;
}

/* um id que não se repete, sem depender de contador em planilha */
function AP_INV_id_(prefixo) {
  var d = new Date();
  function dd(n, q) { var s = String(n); while (s.length < (q || 2)) s = '0' + s; return s; }
  return prefixo + '-' + d.getFullYear() + dd(d.getMonth() + 1) + dd(d.getDate()) +
    '-' + dd(d.getHours()) + dd(d.getMinutes()) + dd(d.getSeconds()) +
    '-' + dd(Math.floor(Math.random() * 10000), 4);
}


/* ============================================================
   2. AS ABAS — achadas, nunca criadas em operação normal
   ============================================================ */

function AP_INV_aba_(nome) {
  var ss = AP_INV_planilha_();
  if (!ss) return null;
  try { return ss.getSheetByName(nome); } catch (e) { return null; }
}

function AP_INV_ler_(nome) {
  var aba = AP_INV_aba_(nome);
  if (!aba) return { existe: false, colunas: [], linhas: [], aba: null };
  var ultima = aba.getLastRow(), colunas = aba.getLastColumn();
  if (ultima < 1 || colunas < 1) {
    return { existe: true, colunas: [], linhas: [], aba: aba };
  }
  var quantas = Math.min(ultima - 1, AP_INV_CFG.tetoLeitura);
  var cab = aba.getRange(1, 1, 1, colunas).getValues()[0].map(AP_INV_txt_);
  var linhas = quantas > 0
    ? aba.getRange(2, 1, quantas, colunas).getValues()
    : [];
  return { existe: true, colunas: cab, linhas: linhas, aba: aba,
           truncado: (ultima - 1) > quantas };
}

/* os nomes dos campos de um registro, para a mensagem dizer o que
   realmente veio em vez de só "não achei" */
function AP_INV_camposDe_(o) {
  var fora = [];
  if (!o || typeof o !== 'object') return '(nada)';
  for (var k in o) {
    if (Object.prototype.hasOwnProperty.call(o, k)) fora.push(k);
  }
  return fora.length ? fora.join(', ') : '(nenhum)';
}

function AP_INV_col_(colunas, nome) {
  var alvo = AP_INV_normal_(nome);
  for (var i = 0; i < colunas.length; i++) {
    if (AP_INV_normal_(colunas[i]) === alvo) return i;
  }
  return -1;
}

/* transforma uma linha num objeto, usando o cabeçalho real */
function AP_INV_objeto_(colunas, linha, numeroDaLinha) {
  var o = { __linha: numeroDaLinha };
  for (var i = 0; i < colunas.length; i++) {
    if (!colunas[i]) continue;
    o[colunas[i]] = AP_INV_txt_(linha[i]);
  }
  return o;
}

/* grava um objeto respeitando o cabeçalho que existe na aba */
function AP_INV_gravar_(nome, objeto) {
  var lido = AP_INV_ler_(nome);
  if (!lido.existe) {
    return AP_INV_erro_('ABA_NAO_EXISTE',
      'A aba "' + nome + '" não existe. Rode AP_INV_INSTALAR antes de usar ' +
      'o inventário móvel. Eu não crio aba sozinho.');
  }
  if (!lido.colunas.length) {
    return AP_INV_erro_('ABA_SEM_CABECALHO',
      'A aba "' + nome + '" existe mas está sem cabeçalho. Rode AP_INV_INSTALAR.');
  }
  var linha = [];
  for (var i = 0; i < lido.colunas.length; i++) {
    var c = lido.colunas[i];
    linha.push(objeto[c] !== undefined ? objeto[c] : '');
  }
  var n = lido.aba.getLastRow() + 1;
  /* a aba tem um número fixo de linhas (1000 por padrão). Sem isto, a
     gravação que passa do limite responde "Those rows are out of bounds"
     e a contagem do funcionário seria perdida em silêncio. */
  AP_INV_garantirAltura_(lido.aba, n);
  AP_INV_garantirLargura_(lido.aba, linha.length);
  lido.aba.getRange(n, 1, 1, linha.length).setValues([linha]);
  SpreadsheetApp.flush();
  return AP_INV_ok_({ linha: n });
}


/* ============================================================
   3. QUEM ESTÁ FALANDO — decidido aqui, não pelo navegador
   (seção 12: "Não confiar em informações de usuário ou permissões
   enviadas apenas pelo navegador.")
   ============================================================ */

function AP_INV_quem_(sessao) {
  var s = sessao || {};
  /* 1 · a sessão que o Core montou */
  var nome = AP_INV_txt_(s.nome) || AP_INV_txt_(s.usuario) || AP_INV_txt_(s.email);
  var id = AP_INV_txt_(s.id) || AP_INV_txt_(s.usuarioId) || AP_INV_txt_(s.matricula);
  /* 2 · quem o Apps Script diz que está executando */
  if (!nome) {
    try { nome = AP_INV_txt_(Session.getActiveUser().getEmail()); } catch (e) {}
  }
  return { nome: nome || '(não identificado)', id: id || '' };
}

/* o payload PODE dizer quem é, mas isso não vale como identidade:
   serve só para comparar com a sessão e recusar quando discordam */
function AP_INV_conferirIdentidade_(payload, sessao) {
  var eu = AP_INV_quem_(sessao);
  var diz = AP_INV_txt_((payload || {}).quem);
  if (diz && eu.nome !== '(não identificado)' &&
      AP_INV_normal_(diz) !== AP_INV_normal_(eu.nome)) {
    return AP_INV_erro_('IDENTIDADE_NAO_CONFERE',
      'A tela disse que quem está conferindo é "' + diz + '", mas a sessão ' +
      'do Core é de "' + eu.nome + '". Não registro conferência em nome de ' +
      'outra pessoa.');
  }
  return null;
}


/* ============================================================
   4. O SALDO DO SISTEMA — pedido a quem já sabe
   ============================================================ */

/* Não tenho cadastro de saldo próprio e não vou inventar um.
   Pergunto ao módulo "locais", que é quem o ALMOX PRO já usa.
   Se ele não responder, o saldo fica DESCONHECIDO — nunca zero.
   ("Nunca transformar erro de banco em valor zero.") */
function AP_INV_saldoDaPosicao_(codigo) {
  var fn = null;
  try { fn = AP_Modulo_locais; } catch (e) { fn = null; }
  if (typeof fn !== 'function') {
    return { conhecido: false, motivo: 'o módulo "locais" não existe neste projeto' };
  }
  var r;
  try { r = fn('listar', {}, {}); } catch (e) {
    return { conhecido: false, motivo: 'o módulo "locais" recusou: ' + e };
  }
  if (typeof r === 'string') { try { r = JSON.parse(r); } catch (e2) { r = null; } }
  if (!r || r.ok === false) {
    return { conhecido: false,
             motivo: 'o módulo "locais" recusou: ' + ((r && r.mensagem) || 'sem resposta') };
  }
  var lista = r.dados || r.lista || [];
  if (Object.prototype.toString.call(lista) !== '[object Array]') {
    return { conhecido: false, motivo: 'o módulo "locais" respondeu sem lista' };
  }
  var alvo = AP_INV_normal_(codigo);
  for (var i = 0; i < lista.length; i++) {
    var l = lista[i];
    if (AP_INV_normal_(l.codigo) !== alvo) continue;

    /* [15/11] O módulo "locais" do Core pode chamar o saldo de vários
       nomes, e eu não tenho o arquivo dele para saber qual é. Em vez de
       adivinhar UM nome e devolver "sem saldo" para sempre, procuro os
       nomes possíveis NA MESMA resposta do mesmo endpoint (locais.listar)
       e digo qual deles usei. Nenhum endpoint novo foi inventado.
       Se nenhum existir, o saldo continua DESCONHECIDO — nunca zero. */
    var candidatos = ['itens', 'quantidade', 'qtd', 'saldo', 'estoque',
                      'quantidadeAtual', 'total'];
    var n = null, campoUsado = '';

    for (var c = 0; c < candidatos.length; c++) {
      var v = l[candidatos[c]];
      if (v === undefined || v === null || v === '') continue;
      if (Object.prototype.toString.call(v) === '[object Array]') {
        n = v.length; campoUsado = candidatos[c] + ' (lista, contei ' + v.length + ')';
        break;
      }
      var tentativa = AP_INV_num_(v);
      if (tentativa !== null) { n = tentativa; campoUsado = candidatos[c]; break; }
    }
    if (n === null &&
        Object.prototype.toString.call(l.ocupacao) === '[object Array]') {
      n = l.ocupacao.length;
      campoUsado = 'ocupacao (lista, contei ' + l.ocupacao.length + ')';
    }

    return { conhecido: n !== null, saldo: n, status: AP_INV_txt_(l.status),
             registro: l, campoUsado: campoUsado,
             motivo: n === null
               ? ('a posição existe no cadastro de localizações, mas a resposta ' +
                  'do módulo "locais" não traz saldo em nenhum dos campos que eu ' +
                  'sei ler (' + candidatos.join(', ') + ', ocupacao). Campos que ' +
                  'vieram: ' + AP_INV_camposDe_(l) + '.')
               : '' };
  }
  return { conhecido: false, naoCadastrada: true,
           motivo: 'o endereço ' + codigo + ' não está no cadastro de localizações' };
}


/* ============================================================
   5. A LINHA DO TEMPO — seção 8
   ============================================================ */

function AP_INV_evento_(atividadeId, codigo, evento, detalhe, sessao) {
  var eu = AP_INV_quem_(sessao);
  return AP_INV_gravar_(AP_INV_CFG.abaEventos, {
    id: AP_INV_id_('EV'),
    quando: AP_INV_agora_(),
    atividadeId: AP_INV_txt_(atividadeId),
    codigo: AP_INV_txt_(codigo),
    quem: eu.nome, quemId: eu.id,
    evento: AP_INV_txt_(evento),
    detalhe: AP_INV_txt_(detalhe)
  });
}


/* ============================================================
   6. ETAPA 1 — O GESTOR CRIA A ATIVIDADE (seção 7)
   ============================================================ */

function AP_INV_criarAtividade(payload, sessao) {
  var p = payload || {};
  var eu = AP_INV_quem_(sessao);

  var tipo = AP_INV_normal_(p.tipo) || 'POSICAO';
  if (AP_INV_CFG.tipos.indexOf(tipo) === -1) {
    return AP_INV_erro_('TIPO_DESCONHECIDO',
      'Tipo de inventário "' + AP_INV_txt_(p.tipo) + '" não existe. ' +
      'Os que existem: ' + AP_INV_CFG.tipos.join(', ') + '.');
  }

  var posicoes = p.posicoes;
  if (Object.prototype.toString.call(posicoes) !== '[object Array]') {
    posicoes = AP_INV_txt_(posicoes) ? AP_INV_txt_(posicoes).split(/[;,\s]+/) : [];
  }
  posicoes = posicoes.map(AP_INV_txt_).filter(function (c) { return !!c; });
  if (!posicoes.length) {
    return AP_INV_erro_('SEM_POSICOES',
      'A atividade precisa de pelo menos uma posição. Criar atividade vazia ' +
      'daria uma tarefa que ninguém consegue executar.');
  }

  /* posição repetida na mesma atividade seria contada duas vezes */
  var vistos = {}, repetidas = [];
  var limpas = [];
  for (var i = 0; i < posicoes.length; i++) {
    var k = AP_INV_normal_(posicoes[i]);
    if (vistos[k]) { repetidas.push(posicoes[i]); continue; }
    vistos[k] = 1;
    limpas.push(posicoes[i]);
  }

  var responsavel = AP_INV_txt_(p.responsavel);
  if (!responsavel) {
    return AP_INV_erro_('SEM_RESPONSAVEL',
      'A atividade precisa de um responsável. Sem isso não há a quem ela ' +
      'aparecer no celular, e a rastreabilidade da seção 8 fica sem dono.');
  }

  var id = AP_INV_id_('ATV');
  var reg = {
    id: id, tipo: tipo,
    galpao: AP_INV_txt_(p.galpao),
    rua: AP_INV_txt_(p.rua), estante: AP_INV_txt_(p.estante),
    prateleira: AP_INV_txt_(p.prateleira),
    posicoes: limpas.join(';'),
    quantasPosicoes: limpas.length,
    responsavel: responsavel,
    responsavelId: AP_INV_txt_(p.responsavelId),
    prazo: AP_INV_txt_(p.prazo),
    instrucoes: AP_INV_txt_(p.instrucoes),
    status: 'ABERTA',
    criadaPor: eu.nome, criadaEm: AP_INV_agora_(),
    iniciadaEm: '', concluidaEm: '', confirmadaPor: '',
    observacao: repetidas.length
      ? 'posições repetidas foram descartadas: ' + repetidas.join(', ')
      : ''
  };

  var g = AP_INV_gravar_(AP_INV_CFG.abaAtividades, reg);
  if (!g.ok) return g;

  /* seção 12: confirmar a persistência relendo, não presumir */
  var conferida = AP_INV_acharAtividade_(id);
  if (!conferida) {
    return AP_INV_erro_('NAO_CONFIRMOU',
      'Escrevi a atividade na linha ' + g.dados.linha + ', mas ao reler não a ' +
      'encontrei. NÃO considere criada.');
  }

  AP_INV_evento_(id, '', 'ATIVIDADE_CRIADA',
    tipo + ' com ' + limpas.length + ' posição(ões) para ' + responsavel, sessao);

  return AP_INV_ok_(conferida, {
    observacao: 'confirmada por releitura na linha ' + conferida.__linha,
    repetidasDescartadas: repetidas
  });
}

/* ============================================================
   6-B. MOTOR DE ROTAS — módulo 01, seções 3, 4 e 5
   ------------------------------------------------------------
   Uma ROTA é um recorte de uma atividade: algumas das posições
   dela, em ordem, com um dono. Serve para o gestor dividir um
   inventário grande entre pessoas, ou dar várias ruas à mesma
   pessoa, sem criar uma atividade para cada pedaço.

   TRÊS DECISÕES, e o porquê de cada uma:

   1. A rota vive DENTRO de uma atividade. Não existe rota solta
      (regra 6 do prompt: "não criar rotas sem vínculo com
      atividades e responsáveis").

   2. As posições da rota têm de estar entre as da atividade. Se
      eu deixasse incluir qualquer endereço, uma rota mandaria o
      funcionário conferir coisa fora do que foi autorizado — e a
      regra 7 diz o contrário.

   3. A rota NÃO guarda cadastro de material. Isso seria banco
      paralelo (regra 4) e duplicação (regra 5). O campo
      "materiais" é um FILTRO: os códigos que o gestor quer
      conferidos ali. Descrição, unidade e saldo continuam vindo
      do Core, na hora da execução.
   ============================================================ */

function AP_INV_listaDePosicoes_(bruto) {
  var v = bruto;
  if (Object.prototype.toString.call(v) !== '[object Array]') {
    v = AP_INV_txt_(v) ? AP_INV_txt_(v).split(/[;,\s]+/) : [];
  }
  var vistos = {}, fora = [];
  for (var i = 0; i < v.length; i++) {
    var c = AP_INV_txt_(v[i]);
    if (!c) continue;
    var k = AP_INV_normal_(c);
    if (vistos[k]) continue;
    vistos[k] = 1;
    fora.push(c);
  }
  return fora;
}

function AP_INV_acharRota_(id) {
  var lido = AP_INV_ler_(AP_INV_CFG.abaRotas);
  if (!lido.existe || !lido.colunas.length) return null;
  var alvo = AP_INV_normal_(id);
  if (!alvo) return null;
  var ci = AP_INV_col_(lido.colunas, 'id');
  if (ci < 0) return null;
  for (var i = 0; i < lido.linhas.length; i++) {
    if (AP_INV_normal_(lido.linhas[i][ci]) === alvo) {
      return AP_INV_objeto_(lido.colunas, lido.linhas[i], i + 2);
    }
  }
  return null;
}

function AP_INV_rotasDaAtividade_(atividadeId) {
  var lido = AP_INV_ler_(AP_INV_CFG.abaRotas);
  if (!lido.existe || !lido.colunas.length) return [];
  var ca = AP_INV_col_(lido.colunas, 'atividadeId');
  if (ca < 0) return [];
  var alvo = AP_INV_normal_(atividadeId), fora = [];
  for (var i = 0; i < lido.linhas.length; i++) {
    if (AP_INV_normal_(lido.linhas[i][ca]) !== alvo) continue;
    fora.push(AP_INV_objeto_(lido.colunas, lido.linhas[i], i + 2));
  }
  fora.sort(function (a, b) {
    return (AP_INV_num_(a.ordem) || 0) - (AP_INV_num_(b.ordem) || 0);
  });
  return fora;
}

/* ETAPA 1 · o gestor cria a rota, no computador */
function AP_INV_criarRota(payload, sessao) {
  var p = payload || {};
  var eu = AP_INV_quem_(sessao);

  var atividadeId = AP_INV_txt_(p.atividadeId);
  var atividade = AP_INV_acharAtividade_(atividadeId);
  if (!atividade) {
    return AP_INV_erro_('ATIVIDADE_NAO_ENCONTRADA',
      'Não achei a atividade "' + atividadeId + '". Uma rota sem atividade ' +
      'ficaria órfã: ninguém saberia de qual inventário ela faz parte.');
  }
  if (AP_INV_normal_(atividade.status) === 'CANCELADA') {
    return AP_INV_erro_('ATIVIDADE_CANCELADA',
      'A atividade ' + atividadeId + ' foi cancelada. Não crio rota nela.');
  }

  var nome = AP_INV_txt_(p.nome);
  if (!nome) {
    return AP_INV_erro_('SEM_NOME',
      'A rota precisa de nome. É por ele que o funcionário a reconhece ' +
      'no celular — "Rota 01 — Rua A — Ferragens".');
  }

  var responsavel = AP_INV_txt_(p.responsavel) || AP_INV_txt_(atividade.responsavel);
  if (!responsavel) {
    return AP_INV_erro_('SEM_RESPONSAVEL',
      'A rota precisa de responsável. Sem dono ela não aparece no celular ' +
      'de ninguém e não há a quem cobrar.');
  }

  var pedidas = AP_INV_listaDePosicoes_(p.posicoes);
  if (!pedidas.length) {
    return AP_INV_erro_('SEM_POSICOES',
      'A rota precisa de pelo menos um local.');
  }

  /* as posições da rota têm de pertencer à atividade */
  var daAtividade = AP_INV_listaDePosicoes_(atividade.posicoes);
  var mapa = {};
  for (var i = 0; i < daAtividade.length; i++) mapa[AP_INV_normal_(daAtividade[i])] = 1;
  var foraDaAtividade = [], dentro = [];
  for (var j = 0; j < pedidas.length; j++) {
    if (mapa[AP_INV_normal_(pedidas[j])]) dentro.push(pedidas[j]);
    else foraDaAtividade.push(pedidas[j]);
  }
  if (foraDaAtividade.length) {
    return AP_INV_erro_('POSICAO_FORA_DA_ATIVIDADE',
      'Estas posições não estão na atividade ' + atividadeId + ': ' +
      foraDaAtividade.join(', ') + '. Não mando ninguém conferir endereço ' +
      'que não foi autorizado. Inclua-as na atividade primeiro.',
      { foraDaAtividade: foraDaAtividade, daAtividade: daAtividade });
  }

  /* a mesma posição em duas rotas seria contada duas vezes */
  var jaRoteadas = {}, irmas = AP_INV_rotasDaAtividade_(atividadeId);
  for (var r = 0; r < irmas.length; r++) {
    if (AP_INV_normal_(irmas[r].status) === 'CANCELADA') continue;
    var dela = AP_INV_listaDePosicoes_(irmas[r].posicoes);
    for (var d = 0; d < dela.length; d++) {
      jaRoteadas[AP_INV_normal_(dela[d])] = irmas[r].id;
    }
  }
  var repetidas = [];
  for (var k = 0; k < dentro.length; k++) {
    var dono = jaRoteadas[AP_INV_normal_(dentro[k])];
    if (dono) repetidas.push(dentro[k] + ' (já está na rota ' + dono + ')');
  }
  if (repetidas.length) {
    return AP_INV_erro_('POSICAO_JA_EM_OUTRA_ROTA',
      'Estas posições já pertencem a outra rota desta atividade: ' +
      repetidas.join('; ') + '. Duas pessoas contando o mesmo endereço ' +
      'geram duas contagens e uma divergência que não existe.',
      { repetidas: repetidas });
  }

  var prioridade = AP_INV_normal_(p.prioridade) || 'NORMAL';
  if (AP_INV_CFG.prioridades.indexOf(prioridade) === -1) {
    return AP_INV_erro_('PRIORIDADE_DESCONHECIDA',
      'Prioridade "' + AP_INV_txt_(p.prioridade) + '" não existe. As que ' +
      'existem: ' + AP_INV_CFG.prioridades.join(', ') + '.');
  }

  var ordem = AP_INV_num_(p.ordem);
  if (ordem === null) ordem = irmas.length + 1;

  var id = AP_INV_id_('ROT');
  var reg = {
    id: id,
    atividadeId: atividadeId,
    nome: nome,
    ordem: ordem,
    deposito: AP_INV_txt_(p.deposito) || AP_INV_txt_(atividade.deposito),
    rua: AP_INV_txt_(p.rua),
    descricao: AP_INV_txt_(p.descricao),
    responsavel: responsavel,
    responsavelId: AP_INV_txt_(p.responsavelId) ||
                   AP_INV_txt_(atividade.responsavelId),
    posicoes: dentro.join(';'),
    quantasPosicoes: dentro.length,
    /* filtro opcional de material — NÃO é cadastro */
    materiais: AP_INV_listaDePosicoes_(p.materiais).join(';'),
    prioridade: prioridade,
    prazo: AP_INV_txt_(p.prazo) || AP_INV_txt_(atividade.prazo),
    status: 'NOVA',
    criadaEm: AP_INV_agora_(),
    criadaPor: eu.nome,
    iniciadaEm: '', concluidaEm: '',
    observacao: AP_INV_txt_(p.observacao)
  };

  var g = AP_INV_gravar_(AP_INV_CFG.abaRotas, reg);
  if (!g.ok) return g;

  var conferida = AP_INV_acharRota_(id);
  if (!conferida) {
    return AP_INV_erro_('NAO_CONFIRMOU',
      'Escrevi a rota na linha ' + g.dados.linha + ', mas ao reler não a ' +
      'encontrei. NÃO considere criada.');
  }

  AP_INV_evento_(atividadeId, '', 'ROTA_CRIADA',
    nome + ' com ' + dentro.length + ' local(is) para ' + responsavel, sessao);

  return AP_INV_ok_(conferida,
    { observacao: 'confirmada por releitura na linha ' + conferida.__linha });
}

/* quanto de uma rota já foi feito — sai das CONTAGENS, não de um
   contador guardado, que poderia divergir do que está gravado */
function AP_INV_estadoDaRota_(rota) {
  var posicoes = AP_INV_listaDePosicoes_(rota.posicoes);
  var feitas = {}, divergentes = 0;
  var lido = AP_INV_ler_(AP_INV_CFG.abaContagens);
  if (lido.existe && lido.colunas.length) {
    var cr = AP_INV_col_(lido.colunas, 'rotaId');
    var ca = AP_INV_col_(lido.colunas, 'atividadeId');
    var cc = AP_INV_col_(lido.colunas, 'codigo');
    var cres = AP_INV_col_(lido.colunas, 'resultado');
    var cst = AP_INV_col_(lido.colunas, 'status');
    var naRota = {};
    for (var q = 0; q < posicoes.length; q++) naRota[AP_INV_normal_(posicoes[q])] = 1;

    for (var i = 0; i < lido.linhas.length; i++) {
      var L = lido.linhas[i];
      if (cst >= 0 && AP_INV_normal_(L[cst]) === 'CANCELADA') continue;
      var codigo = cc >= 0 ? AP_INV_normal_(L[cc]) : '';
      if (!naRota[codigo]) continue;
      /* a contagem conta para esta rota se apontar para ela, ou se
         ainda não existia rotaId e a atividade for a mesma */
      var daRota = cr >= 0 && AP_INV_normal_(L[cr]) === AP_INV_normal_(rota.id);
      var daAtividade = ca >= 0 &&
        AP_INV_normal_(L[ca]) === AP_INV_normal_(rota.atividadeId) &&
        (cr < 0 || !AP_INV_txt_(L[cr]));
      if (!daRota && !daAtividade) continue;
      feitas[codigo] = 1;
      if (cres >= 0 && /DIVERGENCIA/.test(AP_INV_normal_(L[cres]))) divergentes++;
    }
  }
  var faltam = [];
  for (var z = 0; z < posicoes.length; z++) {
    if (!feitas[AP_INV_normal_(posicoes[z])]) faltam.push(posicoes[z]);
  }
  return {
    posicoes: posicoes,
    quantas: posicoes.length,
    feitas: posicoes.length - faltam.length,
    faltam: faltam.length,
    faltamQuais: faltam,
    divergencias: divergentes,
    completa: faltam.length === 0 && posicoes.length > 0
  };
}

/* o status que a rota TEM de verdade, calculado do que está gravado.
   Não invento "em andamento" para rota que ninguém tocou. */
function AP_INV_statusDaRota_(rota, estado) {
  var guardado = AP_INV_normal_(rota.status);
  if (guardado === 'CANCELADA' || guardado === 'CONCLUIDA' ||
      guardado === 'AGUARDANDO_APROVACAO') return guardado;
  if (estado.completa) {
    return estado.divergencias ? 'COM_DIVERGENCIA' : 'AGUARDANDO_APROVACAO';
  }
  if (estado.feitas > 0) {
    return estado.divergencias ? 'COM_DIVERGENCIA' : 'EM_ANDAMENTO';
  }
  if (AP_INV_txt_(rota.iniciadaEm)) return 'EM_ANDAMENTO';
  return guardado === 'AGUARDANDO_INICIO' ? 'AGUARDANDO_INICIO' : 'NOVA';
}

function AP_INV_rotaComProgresso_(rota) {
  var estado = AP_INV_estadoDaRota_(rota);
  var copia = {};
  for (var k in rota) if (Object.prototype.hasOwnProperty.call(rota, k)) copia[k] = rota[k];
  copia.statusCalculado = AP_INV_statusDaRota_(rota, estado);
  copia.progresso = estado;
  copia.porcento = estado.quantas
    ? Math.round((estado.feitas / estado.quantas) * 100) : 0;
  return copia;
}

/* ETAPA 2 · o gestor confere o que distribuiu */
function AP_INV_listarRotas(payload) {
  var p = payload || {};
  var lido = AP_INV_ler_(AP_INV_CFG.abaRotas);
  if (!lido.existe) {
    return AP_INV_erro_('ABA_NAO_EXISTE',
      'A aba "' + AP_INV_CFG.abaRotas + '" não existe. Rode AP_INV_INSTALAR. ' +
      'NÃO devolvo lista vazia como se não houvesse rota nenhuma.');
  }
  if (!lido.colunas.length) {
    return AP_INV_erro_('ABA_SEM_CABECALHO',
      'A aba "' + AP_INV_CFG.abaRotas + '" está sem cabeçalho. Rode AP_INV_INSTALAR.');
  }

  var filtroAtv = AP_INV_normal_(p.atividadeId);
  var filtroStatus = AP_INV_normal_(p.status);
  var fora = [];
  for (var i = 0; i < lido.linhas.length; i++) {
    var o = AP_INV_objeto_(lido.colunas, lido.linhas[i], i + 2);
    if (!AP_INV_txt_(o.id)) continue;
    if (filtroAtv && AP_INV_normal_(o.atividadeId) !== filtroAtv) continue;
    var com = AP_INV_rotaComProgresso_(o);
    if (filtroStatus && AP_INV_normal_(com.statusCalculado) !== filtroStatus) continue;
    fora.push(com);
  }
  fora.sort(function (a, b) {
    var x = AP_INV_normal_(a.atividadeId).localeCompare(AP_INV_normal_(b.atividadeId));
    if (x) return x;
    return (AP_INV_num_(a.ordem) || 0) - (AP_INV_num_(b.ordem) || 0);
  });
  return AP_INV_ok_(fora, { quantas: fora.length, truncado: !!lido.truncado });
}

/* ETAPA 3 · o funcionário abre o celular e vê o que é dele.
   Quem sou eu quem decide é a SESSÃO do Core, não o navegador. */
function AP_INV_minhasRotas(payload, sessao) {
  var eu = AP_INV_quem_(sessao);
  if (eu.nome === '(não identificado)' && !eu.id) {
    return AP_INV_erro_('SEM_SESSAO',
      'Não sei quem está pedindo. Sem sessão do Core eu não mostro rota de ' +
      'ninguém — isso daria acesso a atividade não autorizada.');
  }
  var todas = AP_INV_listarRotas(payload || {});
  if (!todas.ok) return todas;

  var meuNome = AP_INV_normal_(eu.nome), meuId = AP_INV_normal_(eu.id);
  var minhas = [];
  for (var i = 0; i < todas.dados.length; i++) {
    var r = todas.dados[i];
    var ehMinha =
      (meuId && AP_INV_normal_(r.responsavelId) === meuId) ||
      (meuNome && AP_INV_normal_(r.responsavel) === meuNome);
    if (!ehMinha) continue;
    if (AP_INV_normal_(r.statusCalculado) === 'CANCELADA') continue;
    minhas.push(r);
  }
  return AP_INV_ok_(minhas, { quantas: minhas.length, quemSouEu: eu });
}

/* ETAPA 4 · começar a rota marca a hora, e nada mais */
function AP_INV_iniciarRota(payload, sessao) {
  var p = payload || {};
  var rota = AP_INV_acharRota_(AP_INV_txt_(p.rotaId));
  if (!rota) {
    return AP_INV_erro_('ROTA_NAO_ENCONTRADA',
      'Não achei a rota ' + AP_INV_txt_(p.rotaId) + '.');
  }
  if (AP_INV_normal_(rota.status) === 'CANCELADA') {
    return AP_INV_erro_('ROTA_CANCELADA', 'Esta rota foi cancelada.');
  }

  var eu = AP_INV_quem_(sessao);
  if (eu.nome !== '(não identificado)' &&
      AP_INV_normal_(rota.responsavel) !== AP_INV_normal_(eu.nome) &&
      (!eu.id || AP_INV_normal_(rota.responsavelId) !== AP_INV_normal_(eu.id))) {
    return AP_INV_erro_('ROTA_DE_OUTRA_PESSOA',
      'Esta rota é de ' + AP_INV_txt_(rota.responsavel) + '. Não inicio rota ' +
      'em nome de outra pessoa.');
  }

  if (AP_INV_txt_(rota.iniciadaEm)) {
    return AP_INV_ok_(AP_INV_rotaComProgresso_(rota),
      { observacao: 'esta rota já havia sido iniciada em ' + rota.iniciadaEm });
  }

  var m = AP_INV_mudarRota_(rota.id,
    { status: 'EM_ANDAMENTO', iniciadaEm: AP_INV_agora_() });
  if (!m.ok) return m;

  AP_INV_evento_(rota.atividadeId, '', 'ROTA_INICIADA',
    AP_INV_txt_(rota.nome) + ' por ' + eu.nome, sessao);

  var depois = AP_INV_acharRota_(rota.id);
  if (!depois || !AP_INV_txt_(depois.iniciadaEm)) {
    return AP_INV_erro_('NAO_CONFIRMOU',
      'Marquei o início, mas ao reler a rota a hora não estava lá.');
  }
  return AP_INV_ok_(AP_INV_rotaComProgresso_(depois));
}

function AP_INV_mudarRota_(id, campos) {
  var lido = AP_INV_ler_(AP_INV_CFG.abaRotas);
  if (!lido.existe || !lido.colunas.length) {
    return AP_INV_erro_('ABA_NAO_EXISTE', 'A aba de rotas não está pronta.');
  }
  var ci = AP_INV_col_(lido.colunas, 'id');
  if (ci < 0) return AP_INV_erro_('SEM_COLUNA_ID', 'A aba de rotas não tem "id".');
  var alvo = AP_INV_normal_(id);
  for (var i = 0; i < lido.linhas.length; i++) {
    if (AP_INV_normal_(lido.linhas[i][ci]) !== alvo) continue;
    for (var c in campos) {
      if (!Object.prototype.hasOwnProperty.call(campos, c)) continue;
      var col = AP_INV_col_(lido.colunas, c);
      if (col >= 0) lido.aba.getRange(i + 2, col + 1).setValue(campos[c]);
    }
    SpreadsheetApp.flush();
    return AP_INV_ok_({ linha: i + 2 });
  }
  return AP_INV_erro_('ROTA_NAO_ENCONTRADA', 'Não achei a rota ' + id + '.');
}

/* ETAPA 5 · o progresso de uma rota, para a tela e para o painel */
function AP_INV_progressoDaRota(payload) {
  var p = payload || {};
  var rota = AP_INV_acharRota_(AP_INV_txt_(p.rotaId));
  if (!rota) {
    return AP_INV_erro_('ROTA_NAO_ENCONTRADA',
      'Não achei a rota ' + AP_INV_txt_(p.rotaId) + '.');
  }
  var com = AP_INV_rotaComProgresso_(rota);
  var atividade = AP_INV_acharAtividade_(rota.atividadeId);
  return AP_INV_ok_({ rota: com, atividade: atividade || null });
}

function AP_INV_acharAtividade_(id) {
  var lido = AP_INV_ler_(AP_INV_CFG.abaAtividades);
  if (!lido.existe || !lido.colunas.length) return null;
  var ci = AP_INV_col_(lido.colunas, 'id');
  if (ci < 0) return null;
  var alvo = AP_INV_normal_(id);
  for (var i = 0; i < lido.linhas.length; i++) {
    if (AP_INV_normal_(lido.linhas[i][ci]) === alvo) {
      return AP_INV_objeto_(lido.colunas, lido.linhas[i], i + 2);
    }
  }
  return null;
}

function AP_INV_listarAtividades(payload) {
  var p = payload || {};
  var lido = AP_INV_ler_(AP_INV_CFG.abaAtividades);
  if (!lido.existe) {
    return AP_INV_erro_('ABA_NAO_EXISTE',
      'A aba "' + AP_INV_CFG.abaAtividades + '" não existe. Rode AP_INV_INSTALAR. ' +
      'Lista vazia aqui diria que não há atividades, e isso seria outra coisa.');
  }
  if (!lido.colunas.length) return AP_INV_ok_([], { aba: AP_INV_CFG.abaAtividades });

  var quem = AP_INV_normal_(p.responsavel);
  var status = AP_INV_normal_(p.status);
  var saida = [];
  for (var i = 0; i < lido.linhas.length; i++) {
    var o = AP_INV_objeto_(lido.colunas, lido.linhas[i], i + 2);
    if (!AP_INV_txt_(o.id)) continue;
    if (quem && AP_INV_normal_(o.responsavel) !== quem) continue;
    if (status && AP_INV_normal_(o.status) !== status) continue;
    if (!p.incluirCanceladas && AP_INV_normal_(o.status) === 'CANCELADA') continue;
    o.listaDePosicoes = AP_INV_txt_(o.posicoes)
      ? AP_INV_txt_(o.posicoes).split(';') : [];
    saida.push(o);
  }
  return AP_INV_ok_(saida, { aba: AP_INV_CFG.abaAtividades,
                             truncado: !!lido.truncado });
}


/* ============================================================
   7. ETAPA 2 e 3 — O FUNCIONÁRIO ABRE E LÊ O QR (seção 7)
   ============================================================ */

/* o que o leitor devolveu vira endereço. Aceita tanto o QR que o
   mapa imprime (ALMOXA:LOC:A-01-1-A) quanto o código digitado. */
function AP_INV_codigoDoQr_(lido) {
  var t = AP_INV_txt_(lido);
  if (!t) return '';
  var pre = AP_INV_CFG.prefixoQr;
  if (t.toUpperCase().indexOf(pre.toUpperCase()) === 0) {
    return AP_INV_txt_(t.substring(pre.length));
  }
  return t;
}

/* A REGRA MAIS IMPORTANTE DESTA FASE, seção 7 etapa 3:
   "Não permitir que uma leitura de QR de uma posição seja
    registrada como conferência de outra."                      */
function AP_INV_validarQr(payload, sessao) {
  var p = payload || {};
  var atividade = AP_INV_acharAtividade_(AP_INV_txt_(p.atividadeId));
  if (!atividade) {
    return AP_INV_erro_('ATIVIDADE_NAO_ENCONTRADA',
      'Não achei a atividade ' + AP_INV_txt_(p.atividadeId) + '.');
  }
  if (AP_INV_normal_(atividade.status) === 'CANCELADA') {
    return AP_INV_erro_('ATIVIDADE_CANCELADA', 'Esta atividade foi cancelada.');
  }
  if (AP_INV_normal_(atividade.status) === 'CONFIRMADA') {
    return AP_INV_erro_('ATIVIDADE_CONFIRMADA',
      'Esta atividade já foi confirmada. Conferir de novo exige uma atividade nova.');
  }

  /* o funcionário tem de ser o responsável */
  var eu = AP_INV_quem_(sessao);
  if (eu.nome !== '(não identificado)' &&
      AP_INV_normal_(atividade.responsavel) !== AP_INV_normal_(eu.nome)) {
    return AP_INV_erro_('NAO_E_SEU',
      'Esta atividade é de ' + atividade.responsavel + '. Quem está logado é ' +
      eu.nome + '. Conferência de inventário fica com quem recebeu a tarefa.');
  }

  var lido = AP_INV_codigoDoQr_(p.qr || p.codigoLido);
  if (!lido) {
    return AP_INV_erro_('QR_VAZIO', 'Não veio nada do leitor.');
  }

  var daAtividade = AP_INV_txt_(atividade.posicoes)
    ? AP_INV_txt_(atividade.posicoes).split(';') : [];
  var normalizadas = daAtividade.map(AP_INV_normal_);
  var ondeEsta = normalizadas.indexOf(AP_INV_normal_(lido));

  if (ondeEsta === -1) {
    AP_INV_evento_(atividade.id, lido, 'QR_FORA_DA_ATIVIDADE',
      'leu ' + lido + ', que não está nesta atividade', sessao);
    return AP_INV_erro_('QR_FORA_DA_ATIVIDADE',
      'O código lido foi ' + lido + ', e esse endereço NÃO faz parte desta ' +
      'atividade. Não registro a leitura de uma posição como conferência de ' +
      'outra.', { lido: lido, daAtividade: daAtividade });
  }

  /* o esperado, quando a tela diz qual está esperando */
  var esperado = AP_INV_txt_(p.esperado);
  if (esperado && AP_INV_normal_(esperado) !== AP_INV_normal_(lido)) {
    AP_INV_evento_(atividade.id, lido, 'QR_DIFERENTE_DO_ESPERADO',
      'esperava ' + esperado + ', leu ' + lido, sessao);
    return AP_INV_erro_('QR_DIFERENTE_DO_ESPERADO',
      'A tela estava no endereço ' + esperado + ' e o leitor trouxe ' + lido +
      '. São posições diferentes.', { esperado: esperado, lido: lido });
  }

  /* já foi conferida nesta atividade? */
  var jaFeita = AP_INV_contagemDe_(atividade.id, lido);

  var saldo = AP_INV_saldoDaPosicao_(lido);

  AP_INV_evento_(atividade.id, lido, 'QR_VALIDADO', '', sessao);

  return AP_INV_ok_({
    atividadeId: atividade.id,
    codigo: lido,
    posicaoNaAtividade: ondeEsta + 1,
    totalDaAtividade: daAtividade.length,
    jaConferida: !!jaFeita,
    contagemAnterior: jaFeita || null,
    saldoSistema: saldo.conhecido ? saldo.saldo : null,
    saldoConhecido: !!saldo.conhecido,
    porQueSemSaldo: saldo.conhecido ? '' : saldo.motivo,
    posicaoNaoCadastrada: !!saldo.naoCadastrada,
    statusDaPosicao: saldo.status || ''
  });
}

function AP_INV_contagemDe_(atividadeId, codigo) {
  var lido = AP_INV_ler_(AP_INV_CFG.abaContagens);
  if (!lido.existe || !lido.colunas.length) return null;
  var ca = AP_INV_col_(lido.colunas, 'atividadeId');
  var cc = AP_INV_col_(lido.colunas, 'codigo');
  var cs = AP_INV_col_(lido.colunas, 'status');
  if (ca < 0 || cc < 0) return null;
  var a = AP_INV_normal_(atividadeId), c = AP_INV_normal_(codigo);
  for (var i = lido.linhas.length - 1; i >= 0; i--) {
    if (AP_INV_normal_(lido.linhas[i][ca]) !== a) continue;
    if (AP_INV_normal_(lido.linhas[i][cc]) !== c) continue;
    if (cs >= 0 && AP_INV_normal_(lido.linhas[i][cs]) === 'CANCELADA') continue;
    return AP_INV_objeto_(lido.colunas, lido.linhas[i], i + 2);
  }
  return null;
}

function AP_INV_porOperacao_(operacaoId) {
  var op = AP_INV_txt_(operacaoId);
  if (!op) return null;
  var lido = AP_INV_ler_(AP_INV_CFG.abaContagens);
  if (!lido.existe || !lido.colunas.length) return null;
  var co = AP_INV_col_(lido.colunas, 'operacaoId');
  if (co < 0) return null;
  for (var i = 0; i < lido.linhas.length; i++) {
    if (AP_INV_txt_(lido.linhas[i][co]) === op) {
      return AP_INV_objeto_(lido.colunas, lido.linhas[i], i + 2);
    }
  }
  return null;
}


/* ============================================================
   8. ETAPA 4 e 5 — A CONTAGEM E A CONFIRMAÇÃO (seção 7)
   ============================================================ */

/* decide o resultado comparando saldo e contagem. Quando não há
   saldo conhecido, o resultado NÃO é "conferido": é
   SEM_SALDO_PARA_COMPARAR. Dizer 100% conferido sem ter com o que
   comparar seria mentira — e a seção 8 avisa justamente isso. */
function AP_INV_resultado_(saldo, encontrado, marcado) {
  /* 14/11 — AP_INV_normal_ tira o "_", e a lista de resultados TEM
     "_". Eu comparava um contra o outro e a situação marcada pelo
     funcionário nunca entrava: material danificado virava
     "conferido". Agora comparo normalizado contra normalizado. */
  var m = AP_INV_normal_(marcado);
  var conhecido = '';
  for (var i = 0; i < AP_INV_CFG.resultados.length; i++) {
    if (AP_INV_normal_(AP_INV_CFG.resultados[i]) === m) {
      conhecido = AP_INV_CFG.resultados[i]; break;
    }
  }
  /* situação de campo marcada pelo funcionário manda: ele está
     olhando a prateleira, eu não. Divergência e "conferido" não
     entram aqui — esses dois saem da comparação, logo abaixo. */
  if (conhecido && conhecido.indexOf('DIVERGENCIA') === -1 &&
      conhecido !== 'CONFERIDO') {
    return conhecido;
  }

  if (!saldo.conhecido) return 'SEM_SALDO_PARA_COMPARAR';
  if (encontrado === null) return 'SEM_SALDO_PARA_COMPARAR';
  var dif = encontrado - saldo.saldo;
  if (dif === 0) return 'CONFERIDO';
  return dif > 0 ? 'DIVERGENCIA_POSITIVA' : 'DIVERGENCIA_NEGATIVA';
}

function AP_INV_registrarContagem(payload, sessao) {
  var p = payload || {};

  var problema = AP_INV_conferirIdentidade_(p, sessao);
  if (problema) return problema;

  /* IDEMPOTÊNCIA (seção 12): a mesma operação, mandada duas vezes
     — rede ruim, dedo duplo —, não vira duas contagens. */
  var repetida = AP_INV_porOperacao_(p.operacaoId);
  if (repetida) {
    return AP_INV_ok_(repetida, {
      repetida: true,
      observacao: 'esta operação já tinha sido registrada na linha ' +
        repetida.__linha + '. Não gravei de novo.'
    });
  }

  var atividade = AP_INV_acharAtividade_(AP_INV_txt_(p.atividadeId));
  if (!atividade) {
    return AP_INV_erro_('ATIVIDADE_NAO_ENCONTRADA',
      'Não achei a atividade ' + AP_INV_txt_(p.atividadeId) + '.');
  }
  if (AP_INV_normal_(atividade.status) === 'CONFIRMADA') {
    return AP_INV_erro_('ATIVIDADE_CONFIRMADA',
      'Esta atividade já foi confirmada e fechada.');
  }
  if (AP_INV_normal_(atividade.status) === 'CANCELADA') {
    return AP_INV_erro_('ATIVIDADE_CANCELADA', 'Esta atividade foi cancelada.');
  }

  /* o QR manda: a conferência é da posição que foi LIDA */
  var codigo = AP_INV_codigoDoQr_(p.qr || p.codigo);
  if (!codigo) return AP_INV_erro_('SEM_CODIGO', 'Não veio o endereço conferido.');

  var daAtividade = AP_INV_txt_(atividade.posicoes)
    ? AP_INV_txt_(atividade.posicoes).split(';').map(AP_INV_normal_) : [];
  if (daAtividade.indexOf(AP_INV_normal_(codigo)) === -1) {
    return AP_INV_erro_('FORA_DA_ATIVIDADE',
      'O endereço ' + codigo + ' não faz parte desta atividade.');
  }

  var encontrada = AP_INV_num_(p.qtdEncontrada);
  if (encontrada === null && !AP_INV_txt_(p.resultado)) {
    return AP_INV_erro_('SEM_CONTAGEM',
      'Não veio a quantidade encontrada nem uma situação de campo. ' +
      'Gravar conferência sem nenhum dos dois seria registro vazio.');
  }
  if (encontrada !== null && encontrada < 0) {
    return AP_INV_erro_('CONTAGEM_NEGATIVA',
      'Quantidade encontrada negativa (' + encontrada + ') não existe no físico.');
  }

  var saldo = AP_INV_saldoDaPosicao_(codigo);
  var resultado = AP_INV_resultado_(saldo, encontrada, p.resultado);
  var diferenca = (saldo.conhecido && encontrada !== null)
    ? (encontrada - saldo.saldo) : '';

  var eu = AP_INV_quem_(sessao);
  var reg = {
    id: AP_INV_id_('CTG'),
    atividadeId: atividade.id,
    codigo: codigo,
    rua: AP_INV_txt_(p.rua), estante: AP_INV_txt_(p.estante),
    prateleira: AP_INV_txt_(p.prateleira), posicao: AP_INV_txt_(p.posicao),
    qrLido: AP_INV_txt_(p.qr || ''),
    saldoSistema: saldo.conhecido ? saldo.saldo : '',
    qtdEncontrada: encontrada === null ? '' : encontrada,
    diferenca: diferenca,
    resultado: resultado,
    observacao: AP_INV_txt_(p.observacao),
    ocorrencia: AP_INV_txt_(p.ocorrencia),
    /* fotos: só a referência que a tela mandou. Imagem não entra em
       célula de planilha, e eu não invento depósito de arquivo. */
    fotos: AP_INV_txt_(p.fotos),
    quem: eu.nome, quemId: eu.id,
    quando: AP_INV_agora_(),
    operacaoId: AP_INV_txt_(p.operacaoId) || AP_INV_id_('OP'),
    sessaoId: AP_INV_txt_((sessao || {}).sessaoId),
    status: 'ATIVA',
    /* [módulo 01] de qual rota veio esta contagem. Vazio quando a
       contação foi feita direto pela atividade, sem rota — e o
       cálculo de progresso trata os dois casos. */
    rotaId: AP_INV_txt_(p.rotaId)
  };

  var g = AP_INV_gravar_(AP_INV_CFG.abaContagens, reg);
  if (!g.ok) return g;

  /* confirma relendo: seção 12 */
  var conferida = AP_INV_porOperacao_(reg.operacaoId);
  if (!conferida) {
    return AP_INV_erro_('NAO_CONFIRMOU',
      'Escrevi a contagem na linha ' + g.dados.linha + ', mas ao reler não a ' +
      'encontrei. NÃO considere registrada.');
  }

  /* [15/11] A CONTAGEM JÁ ESTÁ GRAVADA E CONFERIDA NESTE PONTO.

     O que vem depois — mudar o status da atividade e escrever a linha
     do tempo — é complemento. Antes, se um desses passos quebrasse, o
     erro subia até o catch do módulo e a resposta inteira virava falha:
     a tela dizia ao conferente que a contagem NÃO foi registrada quando
     ela estava gravada na planilha. Isso faz o operador contar de novo.
     Agora cada passo complementar falha por conta própria e vira aviso,
     sem derrubar o que já foi confirmado.                              */
  var avisos = [];

  /* a atividade sai de ABERTA na primeira contagem */
  if (AP_INV_normal_(atividade.status) === 'ABERTA') {
    try {
      AP_INV_mudarAtividade_(atividade.id,
        { status: 'EM_EXECUCAO', iniciadaEm: AP_INV_agora_() });
    } catch (eStatus) {
      avisos.push('A contagem foi gravada e conferida, mas não consegui ' +
        'mudar o status da atividade para EM_EXECUCAO: ' +
        ((eStatus && eStatus.message) || eStatus));
    }
  }

  try {
    AP_INV_evento_(atividade.id, codigo, 'CONTAGEM_REGISTRADA',
      'resultado ' + resultado +
      (saldo.conhecido ? (' · sistema ' + saldo.saldo + ', físico ' + encontrada) : ''),
      sessao);
  } catch (eEvento) {
    avisos.push('A contagem foi gravada e conferida, mas não consegui ' +
      'escrever a linha do tempo: ' + ((eEvento && eEvento.message) || eEvento));
  }

  return AP_INV_ok_(conferida, {
    avisos: avisos,
    resultado: resultado,
    saldoCampoUsado: saldo.campoUsado || '',
    saldoMotivo: saldo.conhecido ? '' : (saldo.motivo || ''),
    saldoConhecido: !!saldo.conhecido,
    porQueSemSaldo: saldo.conhecido ? '' : saldo.motivo,
    observacao: 'gravada e conferida por releitura na linha ' + conferida.__linha
  });
}

function AP_INV_mudarAtividade_(id, campos) {
  var lido = AP_INV_ler_(AP_INV_CFG.abaAtividades);
  if (!lido.existe || !lido.colunas.length) return false;
  var ci = AP_INV_col_(lido.colunas, 'id');
  if (ci < 0) return false;
  var alvo = AP_INV_normal_(id);
  for (var i = 0; i < lido.linhas.length; i++) {
    if (AP_INV_normal_(lido.linhas[i][ci]) !== alvo) continue;
    for (var c in campos) if (campos.hasOwnProperty(c)) {
      var col = AP_INV_col_(lido.colunas, c);
      if (col >= 0) lido.aba.getRange(i + 2, col + 1).setValue(campos[c]);
    }
    SpreadsheetApp.flush();
    return true;
  }
  return false;
}

function AP_INV_progresso(payload) {
  var p = payload || {};
  var atividade = AP_INV_acharAtividade_(AP_INV_txt_(p.atividadeId));
  if (!atividade) {
    return AP_INV_erro_('ATIVIDADE_NAO_ENCONTRADA', 'Não achei a atividade.');
  }
  var posicoes = AP_INV_txt_(atividade.posicoes)
    ? AP_INV_txt_(atividade.posicoes).split(';') : [];
  var feitas = [], faltam = [], divergentes = [];
  for (var i = 0; i < posicoes.length; i++) {
    var c = AP_INV_contagemDe_(atividade.id, posicoes[i]);
    if (!c) { faltam.push(posicoes[i]); continue; }
    feitas.push(c);
    if (AP_INV_normal_(c.resultado).indexOf('DIVERGENCIA') === 0) divergentes.push(c);
  }
  return AP_INV_ok_({
    atividade: atividade,
    posicoes: posicoes,
    feitas: feitas.length, faltam: faltam.length,
    faltamQuais: faltam,
    divergencias: divergentes.length,
    divergentes: divergentes,
    contagens: feitas,
    completa: faltam.length === 0
  });
}

/* ETAPA 5 — a confirmação é do Core, e só fecha se tudo foi feito */
function AP_INV_confirmarAtividade(payload, sessao) {
  var p = payload || {};
  var pr = AP_INV_progresso(p);
  if (!pr.ok) return pr;
  var d = pr.dados;

  if (AP_INV_normal_(d.atividade.status) === 'CONFIRMADA') {
    return AP_INV_ok_(d.atividade, { repetida: true,
      observacao: 'esta atividade já estava confirmada; não mexi nela de novo' });
  }
  if (!d.completa && !p.forcar) {
    return AP_INV_erro_('FALTAM_POSICOES',
      'Faltam ' + d.faltam + ' posição(ões) sem conferência: ' +
      d.faltamQuais.slice(0, 8).join(', ') +
      (d.faltamQuais.length > 8 ? '…' : '') +
      '. Confirmar agora registraria como conferido o que ninguém olhou.',
      { faltamQuais: d.faltamQuais });
  }

  var eu = AP_INV_quem_(sessao);
  var mudou = AP_INV_mudarAtividade_(d.atividade.id, {
    status: 'CONFIRMADA',
    concluidaEm: AP_INV_agora_(),
    confirmadaPor: eu.nome
  });
  if (!mudou) {
    return AP_INV_erro_('NAO_CONFIRMOU', 'Não consegui atualizar a atividade.');
  }

  var relida = AP_INV_acharAtividade_(d.atividade.id);
  if (!relida || AP_INV_normal_(relida.status) !== 'CONFIRMADA') {
    return AP_INV_erro_('NAO_CONFIRMOU',
      'Marquei como confirmada, mas ao reler ela diz "' +
      ((relida && relida.status) || '?') + '". NÃO considere confirmada.');
  }

  AP_INV_evento_(d.atividade.id, '', 'ATIVIDADE_CONFIRMADA',
    d.feitas + ' posição(ões), ' + d.divergencias + ' divergência(s)' +
    (p.forcar && !d.completa ? ' — CONFIRMADA COM ' + d.faltam + ' PENDENTE(S)' : ''),
    sessao);

  return AP_INV_ok_(relida, {
    feitas: d.feitas, divergencias: d.divergencias,
    faltaram: d.faltam,
    observacao: d.divergencias
      ? 'confirmada com ' + d.divergencias + ' divergência(s). Ajuste de saldo ' +
        'NÃO foi feito: isso depende do fluxo de aprovação do ALMOX PRO.'
      : 'confirmada. Nenhum saldo foi alterado por esta operação.'
  });
}

function AP_INV_cancelarAtividade(payload, sessao) {
  var p = payload || {};
  var a = AP_INV_acharAtividade_(AP_INV_txt_(p.atividadeId));
  if (!a) return AP_INV_erro_('ATIVIDADE_NAO_ENCONTRADA', 'Não achei a atividade.');
  if (!AP_INV_txt_(p.motivo)) {
    return AP_INV_erro_('SEM_MOTIVO', 'Cancelar exige motivo escrito.');
  }
  AP_INV_mudarAtividade_(a.id, {
    status: 'CANCELADA',
    observacao: AP_INV_txt_(a.observacao) +
      (AP_INV_txt_(a.observacao) ? ' | ' : '') + 'cancelada: ' + AP_INV_txt_(p.motivo)
  });
  var relida = AP_INV_acharAtividade_(a.id);
  if (!relida || AP_INV_normal_(relida.status) !== 'CANCELADA') {
    return AP_INV_erro_('NAO_CONFIRMOU', 'Não consegui confirmar o cancelamento.');
  }
  AP_INV_evento_(a.id, '', 'ATIVIDADE_CANCELADA', AP_INV_txt_(p.motivo), sessao);
  return AP_INV_ok_(relida,
    { observacao: 'a linha continua na planilha, com status CANCELADA' });
}


/* ============================================================
   9. SEÇÃO 8 — RASTREABILIDADE
   ============================================================ */

function AP_INV_linhaDoTempo(payload) {
  var p = payload || {};
  var lido = AP_INV_ler_(AP_INV_CFG.abaEventos);
  if (!lido.existe) {
    return AP_INV_erro_('ABA_NAO_EXISTE',
      'A aba "' + AP_INV_CFG.abaEventos + '" não existe. Rode AP_INV_INSTALAR.');
  }
  if (!lido.colunas.length) return AP_INV_ok_([]);

  var porCodigo = AP_INV_normal_(p.codigo);
  var porQuem = AP_INV_normal_(p.quem);
  var porAtividade = AP_INV_normal_(p.atividadeId);
  if (!porCodigo && !porQuem && !porAtividade) {
    return AP_INV_erro_('SEM_FILTRO',
      'Diga de quem ou de qual endereço o senhor quer a linha do tempo. ' +
      'Despejar o histórico inteiro não ajuda ninguém.');
  }

  var saida = [];
  for (var i = 0; i < lido.linhas.length; i++) {
    var o = AP_INV_objeto_(lido.colunas, lido.linhas[i], i + 2);
    if (porCodigo && AP_INV_normal_(o.codigo) !== porCodigo) continue;
    if (porQuem && AP_INV_normal_(o.quem) !== porQuem) continue;
    if (porAtividade && AP_INV_normal_(o.atividadeId) !== porAtividade) continue;
    saida.push(o);
  }
  saida.sort(function (a, b) {
    return AP_INV_txt_(a.quando) < AP_INV_txt_(b.quando) ? -1 : 1;
  });
  return AP_INV_ok_(saida, { quantos: saida.length });
}

/* o painel do funcionário, seção 8 */
function AP_INV_painelDoFuncionario(payload) {
  var p = payload || {};
  var quem = AP_INV_normal_(p.quem);
  if (!quem) return AP_INV_erro_('SEM_FUNCIONARIO', 'Diga de quem é o painel.');

  var lido = AP_INV_ler_(AP_INV_CFG.abaContagens);
  if (!lido.existe) {
    return AP_INV_erro_('ABA_NAO_EXISTE',
      'A aba "' + AP_INV_CFG.abaContagens + '" não existe. Rode AP_INV_INSTALAR.');
  }
  var posicoes = 0, divergencias = 0, conferidas = 0, semSaldo = 0;
  var atividades = {};
  for (var i = 0; i < lido.linhas.length; i++) {
    var o = AP_INV_objeto_(lido.colunas, lido.linhas[i], i + 2);
    if (AP_INV_normal_(o.quem) !== quem) continue;
    if (AP_INV_normal_(o.status) === 'CANCELADA') continue;
    posicoes++;
    atividades[o.atividadeId] = 1;
    var r = AP_INV_normal_(o.resultado);
    if (r.indexOf('DIVERGENCIA') === 0) divergencias++;
    else if (r === 'CONFERIDO') conferidas++;
    else if (r === 'SEMSALDOPARACOMPARAR') semSaldo++;
  }
  var quantasAtividades = 0;
  for (var k in atividades) if (atividades.hasOwnProperty(k)) quantasAtividades++;

  return AP_INV_ok_({
    quem: AP_INV_txt_(p.quem),
    posicoesConferidas: posicoes,
    atividades: quantasAtividades,
    conferidas: conferidas,
    divergencias: divergencias,
    semSaldoParaComparar: semSaldo
  }, {
    /* seção 8, com todas as letras */
    observacao: '"Conferido" quer dizer que o físico bateu com o saldo ' +
      'registrado NAQUELE momento. Não quer dizer auditado por segunda ' +
      'pessoa, nem que o estoque inteiro está correto.'
  });
}

/* seção 9 — a tela de divergências */
function AP_INV_divergencias(payload) {
  var p = payload || {};
  var lido = AP_INV_ler_(AP_INV_CFG.abaContagens);
  if (!lido.existe) {
    return AP_INV_erro_('ABA_NAO_EXISTE',
      'A aba "' + AP_INV_CFG.abaContagens + '" não existe. Rode AP_INV_INSTALAR.');
  }
  if (!lido.colunas.length) return AP_INV_ok_([]);
  var fQuem = AP_INV_normal_(p.quem), fRua = AP_INV_normal_(p.rua);
  var fAtv = AP_INV_normal_(p.atividadeId), fTipo = AP_INV_normal_(p.resultado);
  var saida = [];
  for (var i = 0; i < lido.linhas.length; i++) {
    var o = AP_INV_objeto_(lido.colunas, lido.linhas[i], i + 2);
    if (AP_INV_normal_(o.status) === 'CANCELADA') continue;
    var r = AP_INV_normal_(o.resultado);
    if (r === 'CONFERIDO') continue;
    if (fQuem && AP_INV_normal_(o.quem) !== fQuem) continue;
    if (fRua && AP_INV_normal_(o.rua) !== fRua) continue;
    if (fAtv && AP_INV_normal_(o.atividadeId) !== fAtv) continue;
    if (fTipo && r !== fTipo) continue;
    saida.push(o);
  }
  return AP_INV_ok_(saida, { quantos: saida.length,
    observacao: 'Ajuste de saldo não acontece aqui: segue o fluxo de ' +
                'aprovação do ALMOX PRO, como manda a seção 9.' });
}


/* ============================================================
   10. O ROTEADOR
   ============================================================ */

function AP_INV_executar_(acao, payload, sessao) {
  switch (String(acao || '')) {
    case 'criarAtividade':    return AP_INV_criarAtividade(payload, sessao);
    case 'listarAtividades':  return AP_INV_listarAtividades(payload);
    case 'minhasAtividades':  return AP_INV_listarAtividades(payload);
    case 'validarQr':         return AP_INV_validarQr(payload, sessao);
    case 'registrarContagem': return AP_INV_registrarContagem(payload, sessao);
    case 'progresso':         return AP_INV_progresso(payload);
    case 'confirmar':         return AP_INV_confirmarAtividade(payload, sessao);
    case 'cancelar':          return AP_INV_cancelarAtividade(payload, sessao);
    case 'criarRota':         return AP_INV_criarRota(payload, sessao);
    case 'listarRotas':       return AP_INV_listarRotas(payload);
    case 'minhasRotas':       return AP_INV_minhasRotas(payload, sessao);
    case 'iniciarRota':       return AP_INV_iniciarRota(payload, sessao);
    case 'progressoDaRota':   return AP_INV_progressoDaRota(payload);
    case 'linhaDoTempo':      return AP_INV_linhaDoTempo(payload);
    case 'painelFuncionario': return AP_INV_painelDoFuncionario(payload);
    case 'divergencias':      return AP_INV_divergencias(payload);
    case 'instalado':         return AP_INV_ok_(AP_INV_estadoDasAbas_());
    default:
      return AP_INV_erro_('ACAO_DESCONHECIDA',
        'O módulo invmovel não tem a ação "' + acao + '".',
        { acoes: ['criarAtividade', 'listarAtividades', 'minhasAtividades',
                  'validarQr', 'registrarContagem', 'progresso', 'confirmar',
                  'cancelar', 'linhaDoTempo', 'painelFuncionario',
                  'divergencias', 'instalado',
                  'criarRota', 'listarRotas', 'minhasRotas', 'iniciarRota',
                  'progressoDaRota'] });
  }
}

/* o nome é invmovel, e não inventario, porque inventario JÁ EXISTE
   no Core do Ismael e cinco telas dependem dele */
function AP_Modulo_invmovel(acao, payload, sessao) {
  try {
    return AP_INV_executar_(acao, payload, sessao);
  } catch (e) {
    return AP_INV_erro_('ERRO_NO_MODULO',
      'O módulo de inventário móvel quebrou: ' + ((e && e.message) || e));
  }
}

/* porta direta, para o google.script.run */
function AP_INVMOVEL_direto(texto) {
  var req = {};
  try { req = typeof texto === 'string' ? JSON.parse(texto) : (texto || {}); }
  catch (e) {
    return JSON.stringify(AP_INV_erro_('PEDIDO_ESTRANHO',
      'Não entendi o pedido: ' + e));
  }
  return JSON.stringify(
    AP_Modulo_invmovel(req.acao, req.payload, req.sessao));
}


/* ============================================================
   11. INSTALAÇÃO — separada, e só quando o senhor mandar
   ============================================================ */

function AP_INV_estadoDasAbas_() {
  var nomes = [AP_INV_CFG.abaAtividades, AP_INV_CFG.abaContagens,
               AP_INV_CFG.abaEventos, AP_INV_CFG.abaRotas];
  var colunas = [AP_INV_CFG.colunasAtividades, AP_INV_CFG.colunasContagens,
                 AP_INV_CFG.colunasEventos, AP_INV_CFG.colunasRotas];
  var estado = { completo: true, abas: {} };
  for (var i = 0; i < nomes.length; i++) {
    var lido = AP_INV_ler_(nomes[i]);
    var faltando = [];
    if (lido.existe && lido.colunas.length) {
      for (var c = 0; c < colunas[i].length; c++) {
        if (AP_INV_col_(lido.colunas, colunas[i][c]) < 0) faltando.push(colunas[i][c]);
      }
    }
    estado.abas[nomes[i]] = {
      existe: lido.existe,
      temCabecalho: !!(lido.existe && lido.colunas.length),
      linhas: lido.existe ? lido.linhas.length : 0,
      colunasFaltando: faltando
    };
    if (!lido.existe || !lido.colunas.length || faltando.length) estado.completo = false;
  }
  return estado;
}

/* ------------------------------------------------------------
   11-A. INSTALAÇÃO — por etapas, com nome da função e etapa em
   todo erro. Nenhuma etapa apaga, renomeia ou limpa coisa alguma.

   CAUSA DO ERRO RELATADO NA LINHA 1031, reproduzida em teste:
   o cabeçalho tem 19, 21 e 8 colunas, e o código gravava
   getRange(1, 1, 1, 19).setValues(...) SEM conferir a largura da
   aba. Uma aba do Sheets tem um número fixo de colunas (26 por
   padrão, mas menos em planilha importada ou em aba que alguém
   estreitou). Se a aba tem menos colunas que o cabeçalho, o
   Google responde "Those columns are out of bounds" e a
   instalação morria inteira: não criava as outras duas abas e
   não dizia em que etapa parou. Agora a largura é conferida e
   ampliada antes de gravar, cada aba é tratada por conta própria
   e toda falha volta com função, etapa e a mensagem crua do Google.
   ------------------------------------------------------------ */

/** Monta o registro de uma falha: função, etapa e mensagem crua. */
function AP_INV_falha_(funcao, etapa, aba, e) {
  return {
    funcao: funcao,
    etapa: etapa,
    aba: aba || '(nenhuma)',
    erro: (e && e.message) ? String(e.message) : String(e),
    tipo: (e && e.name) ? String(e.name) : 'Erro'
  };
}

/** Confere o plano de uma aba ANTES de escrever. Devolve a lista de
    problemas; vazia quer dizer que o plano está bom. */
function AP_INV_conferirPlano_(nome, quer) {
  var p = [];
  if (!nome || typeof nome !== 'string' || !AP_INV_txt_(nome)) {
    p.push('o nome da aba está vazio ou não é texto');
  }
  if (quer == null) {
    p.push('a lista de colunas é nula — o AP_INV_CFG não carregou, ou outro ' +
           'arquivo do projeto declarou um AP_INV_CFG diferente');
    return p;
  }
  if (Object.prototype.toString.call(quer) !== '[object Array]') {
    p.push('a lista de colunas não é um array, e sim ' + (typeof quer));
    return p;
  }
  if (!quer.length) {
    p.push('a lista de colunas está vazia — getRange com 0 colunas estoura');
    return p;
  }
  var vistos = {};
  for (var i = 0; i < quer.length; i++) {
    var c = AP_INV_txt_(quer[i]);
    if (!c) { p.push('a coluna ' + (i + 1) + ' está em branco'); continue; }
    if ('=+-@'.indexOf(c.charAt(0)) >= 0) {
      p.push('a coluna "' + c + '" começa com "' + c.charAt(0) +
             '", que o Sheets tenta ler como fórmula');
    }
    var chave = AP_INV_normal_(c);
    if (vistos[chave]) p.push('a coluna "' + c + '" aparece duas vezes no plano');
    vistos[chave] = true;
  }
  return p;
}

/** Garante que a aba tem pelo menos "quantas" colunas. Só ACRESCENTA
    colunas vazias no fim; nunca remove, nunca reordena. */
function AP_INV_garantirLargura_(aba, quantas) {
  var tinha = aba.getMaxColumns();
  if (tinha >= quantas) return { tinha: tinha, acrescentou: 0 };
  aba.insertColumnsAfter(tinha, quantas - tinha);
  return { tinha: tinha, acrescentou: quantas - tinha };
}

/** Mesma ideia para linhas. É por isso que a milésima contagem não
    para de gravar: a aba cresce antes da escrita. */
function AP_INV_garantirAltura_(aba, quantas) {
  var tinha = aba.getMaxRows();
  if (tinha >= quantas) return { tinha: tinha, acrescentou: 0 };
  aba.insertRowsAfter(tinha, quantas - tinha);
  return { tinha: tinha, acrescentou: quantas - tinha };
}

/** Abas com nome parecido — caixa ou espaços diferentes. Serve para
    avisar antes que ele fique com duas abas gêmeas. */
function AP_INV_abasParecidas_(ss, nome) {
  var achados = [], alvo = AP_INV_normal_(nome), folhas = [];
  try { folhas = ss.getSheets(); } catch (e) { folhas = []; }
  for (var i = 0; i < folhas.length; i++) {
    var n = '';
    try { n = folhas[i].getName(); } catch (e2) { n = ''; }
    if (n !== nome && AP_INV_normal_(n) === alvo) achados.push(n);
  }
  return achados;
}

/** Instala UMA aba. Não lança nada: toda falha volta dentro do
    objeto, com a etapa em que parou. */
function AP_INV_instalarUmaAba_(ss, nome, quer) {
  var etapa = 'conferir o plano da aba';
  var avisos = [];
  try {
    var problemas = AP_INV_conferirPlano_(nome, quer);
    if (problemas.length) {
      return { feito: false, falha: AP_INV_falha_('AP_INV_instalarUmaAba_',
        etapa, nome, new Error(problemas.join('; '))) };
    }

    etapa = 'procurar a aba';
    var aba = null;
    try { aba = ss.getSheetByName(nome); } catch (e) { aba = null; }

    var parecidas = AP_INV_abasParecidas_(ss, nome);
    if (parecidas.length) {
      avisos.push('ATENÇÃO: existe aba de nome parecido (' +
        parecidas.join(', ') + '). O nome exato que este módulo usa é "' +
        nome + '". Não renomeei nem apaguei nada — confira se os dados ' +
        'não estão na aba de nome parecido.');
    }

    if (!aba) {
      etapa = 'criar a aba';
      aba = ss.insertSheet(nome);

      etapa = 'alargar a aba nova para ' + quer.length + ' colunas';
      var largura = AP_INV_garantirLargura_(aba, quer.length);

      etapa = 'garantir a linha 1 da aba nova';
      AP_INV_garantirAltura_(aba, 1);

      etapa = 'gravar o cabeçalho na aba nova';
      aba.getRange(1, 1, 1, quer.length).setValues([quer]);

      etapa = 'congelar a linha 1';
      try { aba.setFrozenRows(1); } catch (e3) {
        avisos.push('criei a aba e o cabeçalho, mas não congelei a linha 1: ' +
          (e3 && e3.message ? e3.message : e3));
      }
      return { feito: true, criada: true, avisos: avisos,
        recado: nome + ': criada com ' + quer.length + ' colunas' +
          (largura.acrescentou ? ' (alarguei em ' + largura.acrescentou +
           ' colunas; a aba nasceu com ' + largura.tinha + ')' : '') };
    }

    etapa = 'ler o cabeçalho que já está lá';
    var largura0 = aba.getMaxColumns();
    var ultimaCol = Math.min(aba.getLastColumn(), largura0);
    var cab = ultimaCol > 0
      ? aba.getRange(1, 1, 1, ultimaCol).getValues()[0].map(AP_INV_txt_)
      : [];

    if (!cab.join('')) {
      etapa = 'alargar a aba para ' + quer.length + ' colunas';
      var l2 = AP_INV_garantirLargura_(aba, quer.length);
      etapa = 'garantir a linha 1';
      AP_INV_garantirAltura_(aba, 1);
      etapa = 'gravar o cabeçalho numa aba que estava sem cabeçalho';
      aba.getRange(1, 1, 1, quer.length).setValues([quer]);
      etapa = 'congelar a linha 1';
      try { aba.setFrozenRows(1); } catch (e4) {}
      return { feito: true, ajustada: true, avisos: avisos,
        recado: nome + ': estava sem cabeçalho; escrevi os ' + quer.length +
          ' nomes de coluna' + (l2.acrescentou ? ' (alarguei em ' +
           l2.acrescentou + ' colunas; a aba tinha ' + l2.tinha + ')' : '') };
    }

    etapa = 'ver quais colunas faltam';
    var novas = [];
    for (var c = 0; c < quer.length; c++) {
      if (AP_INV_col_(cab, quer[c]) < 0) novas.push(quer[c]);
    }
    if (!novas.length) {
      return { feito: true, jaEstava: true, avisos: avisos,
        recado: nome + ': já estava certa, com as ' + quer.length +
          ' colunas. Não toquei em nada.' };
    }

    etapa = 'alargar a aba para ' + novas.length + ' coluna(s) nova(s)';
    var l3 = AP_INV_garantirLargura_(aba, cab.length + novas.length);
    etapa = 'acrescentar no fim as colunas que faltam';
    aba.getRange(1, cab.length + 1, 1, novas.length).setValues([novas]);
    return { feito: true, ajustada: true, avisos: avisos,
      recado: nome + ': acrescentei no fim a(s) coluna(s) ' + novas.join(', ') +
        '. A ordem do que já existia não mudou.' +
        (l3.acrescentou ? ' (alarguei em ' + l3.acrescentou + ' colunas)' : '') };

  } catch (e) {
    return { feito: false, avisos: avisos,
      falha: AP_INV_falha_('AP_INV_instalarUmaAba_', etapa, nome, e) };
  }
}

/** Cria as três abas do inventário móvel, SE faltarem, e acrescenta
    colunas que faltem. NÃO apaga nada, NÃO renomeia nada, NÃO limpa
    nada e NÃO toca em nenhuma outra aba. Pode rodar quantas vezes
    quiser: da segunda em diante não faz nada e diz isso. */
function AP_INV_INSTALAR() {
  var saida = { funcao: 'AP_INV_INSTALAR', quando: AP_INV_agora_(),
                concluida: false, criadas: [], ajustadas: [], jaEstavam: [],
                avisos: [], falhas: [] };

  var ss = AP_INV_planilha_();
  if (!ss) {
    saida.falhas.push(AP_INV_falha_('AP_INV_INSTALAR', 'abrir a planilha ativa',
      '', new Error('SpreadsheetApp.getActive() voltou vazio: este script ' +
      'não está amarrado a nenhuma planilha. Abra o editor DE DENTRO da ' +
      'planilha Base Dado almoxarifado (Extensões > Apps Script) e rode de novo.')));
    saida.resumo = 'INSTALAÇÃO NÃO CONCLUÍDA: não há planilha ativa.';
    Logger.log(JSON.stringify(saida, null, 2));
    return saida;
  }
  try { saida.planilha = ss.getName(); } catch (e) {}

  var planos = [
    [AP_INV_CFG.abaAtividades, AP_INV_CFG.colunasAtividades],
    [AP_INV_CFG.abaContagens,  AP_INV_CFG.colunasContagens],
    [AP_INV_CFG.abaEventos,    AP_INV_CFG.colunasEventos],
    [AP_INV_CFG.abaRotas,      AP_INV_CFG.colunasRotas]
  ];

  /* cada aba por conta própria: se uma falhar, as outras ainda
     são instaladas, e a falha diz em que etapa parou */
  for (var i = 0; i < planos.length; i++) {
    var r = AP_INV_instalarUmaAba_(ss, planos[i][0], planos[i][1]);
    if (r.avisos && r.avisos.length) saida.avisos = saida.avisos.concat(r.avisos);
    if (!r.feito) { saida.falhas.push(r.falha); continue; }
    if (r.criada) saida.criadas.push(r.recado);
    else if (r.ajustada) saida.ajustadas.push(r.recado);
    else saida.jaEstavam.push(r.recado);
  }

  try { SpreadsheetApp.flush(); } catch (e) {}

  /* a conferência final não acredita no que eu acabei de fazer:
     relê as abas da planilha */
  saida.estadoAgora = AP_INV_estadoDasAbas_();
  saida.concluida = !saida.falhas.length && !!saida.estadoAgora.completo;

  if (saida.concluida) {
    saida.resumo = 'INSTALAÇÃO CONCLUÍDA. As três abas do inventário móvel ' +
      'existem e têm todas as colunas. ' +
      (saida.criadas.length ? saida.criadas.length + ' criada(s). ' : '') +
      (saida.ajustadas.length ? saida.ajustadas.length + ' ajustada(s). ' : '') +
      (saida.jaEstavam.length ? saida.jaEstavam.length + ' já estava(m) certa(s). ' : '') +
      'Nada foi apagado, renomeado ou limpo.';
  } else if (saida.falhas.length) {
    saida.resumo = 'INSTALAÇÃO NÃO CONCLUÍDA: ' + saida.falhas.length +
      ' falha(s). Veja o campo "falhas" — cada uma diz a função, a etapa e ' +
      'a mensagem do Google. Rode AP_INV_DIAGNOSTICO_INSTALACAO() para o ' +
      'retrato completo da planilha.';
  } else {
    saida.resumo = 'INSTALAÇÃO NÃO CONCLUÍDA: não houve erro, mas a releitura ' +
      'das abas diz que ainda falta coluna. Veja "estadoAgora".';
  }

  saida.observacao = 'Nenhuma aba foi apagada, renomeada ou limpa. Nenhuma ' +
    'outra aba da planilha foi tocada. Rodar de novo não duplica cabeçalho.';
  Logger.log(JSON.stringify(saida, null, 2));
  return saida;
}


/** CONFERIR ROTA — só leitura. Responde a uma pergunta só:
    o projeto onde este arquivo está é o mesmo projeto do Core?

    Serve para o caso do erro MODULO_AUSENTE na tela: o roteador do
    Core diz que ninguém atende "invmovel". Isso tem três causas
    possíveis, e esta função separa as três:

      1. o arquivo não está salvo neste projeto
         → "AP_Modulo_invmovel" NÃO aparece na lista abaixo;

      2. o arquivo está num projeto DIFERENTE do Core
         → "AP_Modulo_invmovel" aparece sozinho, sem os outros
           módulos do sistema (locais, estoque, usuarios...);

      3. o arquivo está no lugar certo, mas a IMPLANTAÇÃO do app da
         web ainda serve a versão antiga do código
         → "AP_Modulo_invmovel" aparece JUNTO com os outros módulos.
           Nesse caso o editor enxerga, mas o /exec não: é preciso
           Implantar > Gerenciar implantações > editar (lápis) >
           Versão: Nova versão > Implantar. A URL não muda.          */
function AP_INV_CONFERIR_ROTA() {
  var saida = { funcao: 'AP_INV_CONFERIR_ROTA', quando: AP_INV_agora_(),
                aviso: 'Esta rotina S\u00d3 L\u00ca. N\u00e3o grava nada.' };

  /* o objeto global, sem depender de globalThis */
  var raiz = null;
  try { raiz = (function () { return this; })(); } catch (e) { raiz = null; }
  if (!raiz) { try { raiz = globalThis; } catch (e2) { raiz = null; } }

  /* 1 · quais módulos este projeto publica */
  var modulos = [];
  if (raiz) {
    for (var k in raiz) {
      try {
        if (k.indexOf('AP_Modulo_') === 0 && typeof raiz[k] === 'function') {
          modulos.push(k.substring('AP_Modulo_'.length));
        }
      } catch (e3) {}
    }
    modulos.sort();
  }
  saida.modulosNesteProjeto = modulos;
  saida.quantos = modulos.length;

  /* 2 · eu estou entre eles? */
  var euExisto = false;
  try { euExisto = (typeof AP_Modulo_invmovel === 'function'); } catch (e) {}
  saida.AP_Modulo_invmovel_existe = euExisto;

  /* 3 · a planilha deste projeto */
  var ss = AP_INV_planilha_();
  saida.planilhaDesteProjeto = ss ? { nome: '', id: '' } : null;
  if (ss) {
    try { saida.planilhaDesteProjeto.nome = ss.getName(); } catch (e) {}
    try { saida.planilhaDesteProjeto.id = ss.getId(); } catch (e) {}
  }

  /* 4 · chamo a mim mesmo, do jeito que o roteador chamaria */
  if (euExisto) {
    try {
      var r = AP_Modulo_invmovel('listarAtividades', {}, null);
      saida.testeDeChamada = {
        respondeu: true,
        ok: !!(r && r.ok),
        codigo: (r && r.codigo) || '',
        mensagem: (r && r.mensagem) || '',
        quantasAtividades: (r && r.dados && r.dados.length !== undefined)
          ? r.dados.length : '(n\u00e3o veio lista)'
      };
    } catch (e4) {
      saida.testeDeChamada = { respondeu: false,
        erro: (e4 && e4.message) ? e4.message : String(e4) };
    }
  } else {
    saida.testeDeChamada = { respondeu: false,
      erro: 'AP_Modulo_invmovel n\u00e3o existe neste projeto' };
  }

  /* 5 · veredito */
  var outros = [];
  for (var i = 0; i < modulos.length; i++) {
    if (modulos[i] !== 'invmovel') outros.push(modulos[i]);
  }
  saida.outrosModulosDoSistema = outros;

  if (!euExisto) {
    saida.veredito = 'CAUSA 1: o AP_INVENTARIO.gs N\u00c3O est\u00e1 salvo neste ' +
      'projeto. Cole o arquivo inteiro num arquivo novo do Apps Script ' +
      '(nome sugerido: AP_INVENTARIO.gs), salve, e rode de novo.';
  } else if (!outros.length) {
    saida.veredito = 'CAUSA 2: o AP_Modulo_invmovel existe, mas este projeto ' +
      'N\u00c3O tem nenhum outro m\u00f3dulo do sistema (locais, estoque, usuarios...). ' +
      'Ou seja: o arquivo foi colado num projeto DIFERENTE do Core. Cole-o no ' +
      'projeto do Core \u2014 o mesmo que responde pela URL /exec que a tela usa.';
  } else {
    saida.veredito = 'CAUSA 3 (a mais prov\u00e1vel): o AP_Modulo_invmovel est\u00e1 ' +
      'no projeto certo, junto com ' + outros.length + ' outro(s) m\u00f3dulo(s) (' +
      outros.join(', ') + '). O EDITOR enxerga. Se a tela ainda diz ' +
      'MODULO_AUSENTE, quem n\u00e3o enxerga \u00e9 a IMPLANTA\u00c7\u00c3O: o app da web ainda ' +
      'serve a vers\u00e3o antiga do c\u00f3digo. Fa\u00e7a Implantar > Gerenciar ' +
      'implanta\u00e7\u00f5es > l\u00e1pis (editar) > Vers\u00e3o: Nova vers\u00e3o > Implantar. ' +
      'A URL /exec continua a mesma; s\u00f3 o c\u00f3digo servido muda.';
  }

  Logger.log(JSON.stringify(saida, null, 2));
  return saida;
}


/** DIAGNÓSTICO DA INSTALAÇÃO — só leitura, não grava nada.
    Procura, uma por uma, cada coisa capaz de fazer o getRange do
    cabeçalho estourar, e termina com um veredito. */
function AP_INV_DIAGNOSTICO_INSTALACAO() {
  var saida = { funcao: 'AP_INV_DIAGNOSTICO_INSTALACAO',
                quando: AP_INV_agora_(),
                aviso: 'Esta rotina SÓ LÊ. Não cria, não grava, não apaga.',
                planilha: {}, abas: [], suspeitas: [], veredito: '' };

  /* 1 · o AP_INV_CFG carregou? */
  var cfgOk = false;
  try { cfgOk = (typeof AP_INV_CFG !== 'undefined') && AP_INV_CFG != null; }
  catch (e) { cfgOk = false; }
  saida.cfg = { carregou: cfgOk };
  if (cfgOk) {
    saida.cfg.nomesDasAbas = [AP_INV_CFG.abaAtividades,
      AP_INV_CFG.abaContagens, AP_INV_CFG.abaEventos];
    saida.cfg.quantasColunas = {
      atividades: (AP_INV_CFG.colunasAtividades || []).length,
      contagens:  (AP_INV_CFG.colunasContagens  || []).length,
      eventos:    (AP_INV_CFG.colunasEventos    || []).length
    };
    if (!saida.cfg.quantasColunas.atividades ||
        !saida.cfg.quantasColunas.contagens ||
        !saida.cfg.quantasColunas.eventos) {
      saida.suspeitas.push('CAUSA POSSÍVEL: alguma lista de colunas do ' +
        'AP_INV_CFG está vazia ou ausente. Com ela vazia, quer.length dá 0 ' +
        'e o getRange estoura. Confira se outro arquivo do projeto não ' +
        'declarou um AP_INV_CFG por cima deste.');
    }
  } else {
    saida.suspeitas.push('CAUSA ENCONTRADA: o AP_INV_CFG não existe neste ' +
      'projeto. Sem ele, quer.length não existe e a gravação do cabeçalho ' +
      'estoura. O arquivo AP_INVENTARIO.gs foi colado inteiro?');
  }

  /* 2 · a planilha */
  var ss = AP_INV_planilha_();
  if (!ss) {
    saida.suspeitas.push('CAUSA ENCONTRADA: SpreadsheetApp.getActive() voltou ' +
      'vazio — o script não está amarrado a nenhuma planilha.');
    saida.veredito = 'Não há planilha ativa. Abra o Apps Script de dentro da ' +
      'planilha (Extensões > Apps Script) e rode de novo.';
    Logger.log(JSON.stringify(saida, null, 2));
    return saida;
  }
  try { saida.planilha.nome = ss.getName(); } catch (e) {}
  try { saida.planilha.id = ss.getId(); } catch (e) {}
  try { saida.planilha.euSou = Session.getActiveUser().getEmail() ||
        '(o Google não informou)'; } catch (e) {
    saida.planilha.euSou = '(o Google não informou)';
  }

  try {
    var todas = ss.getSheets(), nomes = [], celulas = 0;
    for (var t = 0; t < todas.length; t++) {
      try { nomes.push(todas[t].getName()); } catch (e8) {}
      try { celulas += todas[t].getMaxRows() * todas[t].getMaxColumns(); }
      catch (e9) {}
    }
    saida.planilha.quantasAbas = todas.length;
    saida.planilha.nomesDasAbas = nomes;
    saida.planilha.celulasReservadas = celulas;
    saida.planilha.tetoDoGoogle = 10000000;
    if (celulas > 9500000) {
      saida.suspeitas.push('CAUSA POSSÍVEL: a planilha já reservou ' + celulas +
        ' células, perto do teto de 10 milhões do Google. Criar aba nova ou ' +
        'alargar aba pode falhar por isso.');
    }
  } catch (e) {
    saida.suspeitas.push('Não consegui listar as abas: ' + (e.message || e));
  }

  try {
    var faixas = ss.getProtections(SpreadsheetApp.ProtectionType.RANGE) || [];
    saida.planilha.faixasProtegidas = faixas.length;
  } catch (e) { saida.planilha.faixasProtegidas = '(não consegui ler)'; }

  if (!cfgOk) {
    saida.veredito = 'O AP_INV_CFG não carregou — veja as suspeitas.';
    Logger.log(JSON.stringify(saida, null, 2));
    return saida;
  }

  /* 3 · aba por aba, tudo que pode estourar */
  var planos = [
    [AP_INV_CFG.abaAtividades, AP_INV_CFG.colunasAtividades],
    [AP_INV_CFG.abaContagens,  AP_INV_CFG.colunasContagens],
    [AP_INV_CFG.abaEventos,    AP_INV_CFG.colunasEventos],
    [AP_INV_CFG.abaRotas,      AP_INV_CFG.colunasRotas]
  ];

  for (var i = 0; i < planos.length; i++) {
    var nome = planos[i][0], quer = planos[i][1] || [];
    var d = { aba: nome, cabecalhoPrecisaDe: quer.length };

    var problemas = AP_INV_conferirPlano_(nome, planos[i][1]);
    d.planoOk = !problemas.length;
    if (problemas.length) {
      d.problemasDoPlano = problemas;
      saida.suspeitas.push('CAUSA ENCONTRADA na aba "' + nome + '": ' +
        problemas.join('; '));
    }

    var aba = null;
    try { aba = ss.getSheetByName(nome); } catch (e) { aba = null; }
    d.existe = !!aba;

    d.nomesParecidos = AP_INV_abasParecidas_(ss, nome);
    if (d.nomesParecidos.length) {
      saida.suspeitas.push('ATENÇÃO: existe aba de nome parecido com "' +
        nome + '" (' + d.nomesParecidos.join(', ') + '). Se os dados estão ' +
        'nela, o módulo não vai encontrá-los: o nome tem de ser exato.');
    }

    if (!aba) {
      d.observacao = 'ainda não existe; a instalação vai criá-la';
      saida.abas.push(d);
      continue;
    }

    try { d.colunasQueAAbaTem = aba.getMaxColumns(); } catch (e) {}
    try { d.linhasQueAAbaTem  = aba.getMaxRows(); } catch (e) {}
    try { d.ultimaColunaUsada = aba.getLastColumn(); } catch (e) {}
    try { d.ultimaLinhaUsada  = aba.getLastRow(); } catch (e) {}
    try { d.oculta = aba.isSheetHidden(); } catch (e) {}
    try {
      d.protecoesNaAba =
        (aba.getProtections(SpreadsheetApp.ProtectionType.SHEET) || []).length;
    } catch (e) { d.protecoesNaAba = '(não consegui ler)'; }

    /* é ESTE o teste da linha 1031 */
    if (typeof d.colunasQueAAbaTem === 'number' &&
        d.colunasQueAAbaTem < quer.length) {
      d.cabeOCabecalho = false;
      saida.suspeitas.push('CAUSA ENCONTRADA: a aba "' + nome + '" tem ' +
        d.colunasQueAAbaTem + ' colunas e o cabeçalho precisa de ' +
        quer.length + '. getRange(1, 1, 1, ' + quer.length + ') responde ' +
        '"Those columns are out of bounds" — é exatamente o erro da linha ' +
        '1031. A correção alarga a aba antes de gravar.');
    } else {
      d.cabeOCabecalho = true;
    }

    if (d.protecoesNaAba && d.protecoesNaAba !== '(não consegui ler)') {
      saida.suspeitas.push('CAUSA POSSÍVEL: a aba "' + nome + '" tem ' +
        d.protecoesNaAba + ' proteção(ões). Se o senhor não estiver na ' +
        'lista de editores dela, o setValues responde "You are trying to ' +
        'edit a protected cell or object".');
    }

    try {
      var lc = Math.min(d.ultimaColunaUsada || 0, d.colunasQueAAbaTem || 0);
      var cab = lc > 0
        ? aba.getRange(1, 1, 1, lc).getValues()[0].map(AP_INV_txt_) : [];
      d.cabecalhoAtual = cab;
      d.temCabecalho = !!cab.join('');
      var faltando = [];
      for (var c = 0; c < quer.length; c++) {
        if (AP_INV_col_(cab, quer[c]) < 0) faltando.push(quer[c]);
      }
      d.colunasFaltando = faltando;
    } catch (e) {
      d.cabecalhoAtual = '(não consegui ler: ' + (e.message || e) + ')';
      saida.suspeitas.push('CAUSA POSSÍVEL: nem a LEITURA do cabeçalho da ' +
        'aba "' + nome + '" funcionou: ' + (e.message || e));
    }

    saida.abas.push(d);
  }

  /* 4 · veredito */
  var encontradas = [];
  for (var s = 0; s < saida.suspeitas.length; s++) {
    if (saida.suspeitas[s].indexOf('CAUSA ENCONTRADA') === 0) {
      encontradas.push(saida.suspeitas[s]);
    }
  }
  if (encontradas.length) {
    saida.veredito = 'CAUSA IDENTIFICADA (' + encontradas.length + '). ' +
      encontradas.join(' | ');
  } else if (saida.suspeitas.length) {
    saida.veredito = 'Nenhuma causa definitiva, mas há ' +
      saida.suspeitas.length + ' ponto(s) de atenção acima.';
  } else {
    saida.veredito = 'Nenhum impedimento encontrado: a planilha está ' +
      'acessível, o AP_INV_CFG carregou e as abas cabem o cabeçalho. ' +
      'Se o erro voltar, copie a MENSAGEM inteira que o Apps Script mostrar ' +
      '— agora ela vem com função e etapa.';
  }

  Logger.log(JSON.stringify(saida, null, 2));
  return saida;
}


/* ============================================================
   12. DIAGNÓSTICO — só leitura
   ============================================================ */

function AP_INV_DIAGNOSTICO() {
  var saida = { quando: AP_INV_agora_(), avisos: [] };
  var ss = AP_INV_planilha_();
  if (!ss) {
    saida.avisos.push('NÃO HÁ PLANILHA ATIVA para este script.');
    Logger.log(JSON.stringify(saida, null, 2));
    return saida;
  }
  try { saida.planilha = ss.getName(); } catch (e) {}

  saida.abasDoInventarioMovel = AP_INV_estadoDasAbas_();
  if (!saida.abasDoInventarioMovel.completo) {
    saida.avisos.push('Falta instalar: rode AP_INV_INSTALAR.');
  }

  /* não atropelei ninguém? */
  saida.modulosQueJaExistem = {};
  var checar = ['inventario', 'atividades', 'locais', 'estoque'];
  for (var i = 0; i < checar.length; i++) {
    var nf = 'AP_Modulo_' + checar[i];
    var existe = false;
    try { existe = typeof eval(nf) === 'function'; } catch (e) { existe = false; }
    saida.modulosQueJaExistem[checar[i]] = existe;
  }
  saida.meuNome = 'invmovel';
  saida.euSouOutroModulo = 'não publico AP_Modulo_inventario nem ' +
    'AP_Modulo_atividades: esses são seus e cinco telas dependem deles';

  /* o saldo vem do módulo locais; testo se ele responde */
  var teste = AP_INV_saldoDaPosicao_('__TESTE_QUE_NAO_EXISTE__');
  saida.saldoVemDe = teste.conhecido
    ? 'módulo locais'
    : ('não consegui ler saldo agora: ' + teste.motivo);

  Logger.log(JSON.stringify(saida, null, 2));
  return saida;
}
