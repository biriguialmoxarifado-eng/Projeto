/* ============================================================
   6. AJUDANTES
   ============================================================ */
function AP_MAILPED_lp_(v) {
  return String(v === undefined || v === null ? '' : v).trim();
}
function AP_MAILPED_esc_(v) {
  return String(v === undefined || v === null ? '' : v)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function AP_MAILPED_chaveMat_(v) {
  return AP_MAILPED_lp_(v).toUpperCase().replace(/[^A-Z0-9]/g, '').replace(/^0+/, '');
}
function AP_MAILPED_chaveNome_(v) {
  return AP_MAILPED_lp_(v).toUpperCase()
    .replace(/[ÁÀÂÃÄ]/g, 'A').replace(/[ÉÈÊË]/g, 'E').replace(/[ÍÌÎÏ]/g, 'I')
    .replace(/[ÓÒÔÕÖ]/g, 'O').replace(/[ÚÙÛÜ]/g, 'U').replace(/Ç/g, 'C')
    .replace(/\s+/g, ' ').trim();
}
function AP_MAILPED_emailValido_(v) {
  var t = AP_MAILPED_lp_(v);
  return /^[^@\s]+@[^@\s]+\.[A-Za-z]{2,}$/.test(t);
}
function AP_MAILPED_dataHora_(v) {
  if (!v) return '—';
  var d = new Date(v);
  if (isNaN(d.getTime())) return AP_MAILPED_lp_(v);
  function z(n) { return (n < 10 ? '0' : '') + n; }
  return z(d.getDate()) + '/' + z(d.getMonth() + 1) + '/' + d.getFullYear() +
    ' às ' + z(d.getHours()) + ':' + z(d.getMinutes());
}
function AP_MAILPED_numero_(v) {
  var n = Number(v);
  if (!isFinite(n)) return AP_MAILPED_lp_(v) || '—';
  return n.toLocaleString('pt-BR');
}
/* ============================================================
   [MAILIMG] AS IMAGENS VÊM DE DENTRO — nada a configurar
   ------------------------------------------------------------
   03/11 18:14, ele: "não é para mim configurar, é para você já
   configurar o layout; já tem tudo".
   Estava certo. Agora as imagens moram no ALMOXA_EMAIL_IMAGENS e
   viajam COM o e-mail, como inlineImages do MailApp — o corpo
   aponta com src="cid:nome". Gmail, Outlook e celular mostram
   todos. Nada hospedado, nenhum endereço para digitar.
   Quem quiser trocar por um endereço público ainda pode: cfg.logo
   e cfg.fotoObra, quando preenchidos, ganham do embutido.
   ============================================================ */
var AP_MAILPED_USADAS = {};

function AP_MAILPED_temImagem_(nome) {
  try { return !!(AP_MAILPED_IMAGENS && AP_MAILPED_IMAGENS[nome]); }
  catch (e) { return false; }
}

/** O endereço de uma imagem: cid quando embutida, URL quando ele
    mandou uma, vazio quando não há nenhuma das duas. */
function AP_MAILPED_src_(nome, urlOpcional) {
  var u = AP_MAILPED_lp_(urlOpcional);
  if (u) return u;
  if (!AP_MAILPED_temImagem_(nome)) return '';
  AP_MAILPED_USADAS[nome] = true;
  return 'cid:' + nome;
}

function AP_MAILPED_ico_(base, nome) {
  /* base preenchida = ele apontou uma pasta pública; senão, embutida */
  var b = AP_MAILPED_lp_(base);
  if (b) {
    if (b.charAt(b.length - 1) !== '/') b += '/';
    return b + nome + '.png';
  }
  return AP_MAILPED_src_(nome, '');
}
function AP_MAILPED_img_(url, px) {
  if (!url) return '';
  return '<img src="' + AP_MAILPED_esc_(url) + '" width="' + px + '" height="' + px +
    '" alt="" style="display:block;border:0;width:' + px + 'px;height:' + px + 'px;margin:0 auto">';
}

/* ============================================================
   7. O MODELO — a mesma arte da prévia do sistema
   ------------------------------------------------------------
   Tabelas e estilo inline em cada célula. O Outlook usa o motor
   do Word: não tem flex, não tem grid, ignora <style> e corta
   class. Arredondado e sombra aparecem no Gmail e no celular; no
   Outlook antigo viram canto reto — de propósito: prefiro
   quadrado que funciona a redondo que quebra.
   ============================================================ */
function AP_MAILPED_montar_(pedido, cfg, o) {
  var AZUL = '#0B2A55', AZUL2 = '#0F5BD8', CLARO = '#EAF2FB',
      CINZA = '#5F6B7A', LINHA = '#C9D3E0', VERDE = '#16A34A';
  var p = pedido || {}, base = AP_MAILPED_lp_(cfg.icones);
  AP_MAILPED_USADAS = {};
  var srcLogo = AP_MAILPED_src_('logo-coesa', cfg.logo);
  var srcFoto = AP_MAILPED_src_('foto-obra', cfg.fotoObra);
  var et = AP_MAILPED_etapaDe_(p);
  var ULT = AP_MAILPED_ETAPAS.length - 1;

  var itens = (function () {
    if (p.listaItens && p.listaItens.length) return p.listaItens;
    if (p.itens && p.itens.length) return p.itens;
    return [{ descricao: AP_MAILPED_lp_(p.descricao || p.item) || '—',
              qtd: p.qtd, unidade: AP_MAILPED_lp_(p.unidade) || 'un',
              situacao: AP_MAILPED_lp_(p.status) }];
  })();

  var h = p.historico || [];
  var quando = [];
  for (var i = 0; i < AP_MAILPED_ETAPAS.length; i++) {
    quando.push(h[i] ? AP_MAILPED_lp_(h[i].quando) : '');
  }
  var ultima = h.length ? h[h.length - 1]
    : { quando: AP_MAILPED_lp_(p.data || p.emissao), texto: 'Pedido registrado no ALMOXA PRO.' };

  function bola(n, estado) {
    var fundo = estado === 'futuro' ? '#FFFFFF' : AZUL2;
    var borda = estado === 'futuro' ? LINHA : AZUL2;
    var cor = estado === 'futuro' ? '#9AA4B2' : '#FFFFFF';
    var tam = estado === 'atual' ? 62 : 54;
    var u = AP_MAILPED_ico_(base, 'etapa-' + (n + 1) + (estado === 'futuro' ? '-cinza' : '-branco'));
    var dentro = u ? AP_MAILPED_img_(u, Math.round(tam * 0.5))
      : '<span style="font-family:Arial,Helvetica,sans-serif;font-size:19px;' +
        'font-weight:bold;color:' + cor + '">' + (n + 1) + '</span>';
    return '<table role="presentation" cellpadding="0" cellspacing="0" border="0" ' +
      'align="center" style="margin:0 auto"><tr><td width="' + tam + '" height="' + tam +
      '" align="center" valign="middle" style="width:' + tam + 'px;height:' + tam +
      'px;border-radius:' + (tam / 2) + 'px;background:' + fundo + ';border:2px solid ' +
      borda + ';text-align:center;vertical-align:middle">' + dentro + '</td></tr></table>';
  }

  var cBola = '', cRot = '';
  AP_MAILPED_ETAPAS.forEach(function (e, i) {
    var estado = i < et.indice ? 'feito' : (i === et.indice ? 'atual' : 'futuro');
    var tam = estado === 'atual' ? 62 : 54;
    var visto = AP_MAILPED_ico_(base, 'visto-verde');
    cBola += '<td width="20%" align="center" valign="top" style="width:20%;padding:0">' +
      '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>' +
      '<td valign="middle" style="padding:0">' +
      (i === 0 ? '' : '<div style="height:3px;background:' +
        (i <= et.indice ? AZUL2 : LINHA) + ';font-size:0;line-height:0"></div>') + '</td>' +
      '<td width="' + tam + '" valign="middle" style="width:' + tam + 'px;padding:0">' +
