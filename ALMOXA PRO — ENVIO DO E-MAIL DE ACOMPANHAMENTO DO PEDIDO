var AP_MAILPED_MAPA = {
  EMITIDO: 0, REGISTRADO: 0, ABERTO: 0, ABERTA: 0, PENDENTE: 0,
  AGUARDANDO_APROVACAO: 0, APROVADO: 0, APROVADA: 0,
