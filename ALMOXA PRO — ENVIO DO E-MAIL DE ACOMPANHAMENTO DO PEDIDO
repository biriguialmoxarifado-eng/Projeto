/* [SOZINHO] 03/11 18:40 — ele instalou e a tela disse três vezes
   "O [MAILPED] não foi configurado. Rode AP_MAILPED_configurar()".
   Não estava quebrado: faltava um passo manual. Mas ele já tinha
   dito, com todas as letras, que não quer configurar nada — e ele
   está certo: um módulo que precisa de ritual para existir é um
   módulo mal feito.
   Agora, na primeira vez que alguém pede a configuração e ela não
   existe, ela se cria com os valores de fábrica — que já vêm com
   as imagens embutidas e o envio DESLIGADO. Instalar passa a ser
   colar os dois arquivos, e nada mais. */
/* [CAMPONOVO] 04/11 — a tela dele disse "nenhum remetente
   configurado" com o remetente escrito no arquivo. A causa: a
   configuração dele foi GRAVADA ontem, antes de existir o campo
   remetente. Esta função só lia o que estava gravado, então todo
   campo que eu acrescentasse depois nascia vazio para quem já
   tinha configurado uma vez — e só funcionaria para instalação
   nova. Isso ia se repetir a cada campo novo.
   Agora eu completo o que falta com o valor de fábrica, sem
   tocar em nada que ele já tenha escolhido. */
function AP_MAILPED_cfg_() {
  var t = PropertiesService.getScriptProperties().getProperty('MAILPED_CFG');
  if (!t) {
    AP_MAILPED_configurar();
    t = PropertiesService.getScriptProperties().getProperty('MAILPED_CFG');
  }
  var guardada = {};
  try { guardada = JSON.parse(t) || {}; } catch (e) { guardada = {}; }

  var padrao = AP_MAILPED_padrao_();
  var faltou = [];
  for (var k in padrao) {
    if (guardada[k] === undefined || guardada[k] === null) {
      guardada[k] = padrao[k];
      faltou.push(k);
    }
  }
  if (faltou.length) {
    PropertiesService.getScriptProperties()
      .setProperty('MAILPED_CFG', JSON.stringify(guardada));
    Logger.log('[MAILPED] campo(s) novo(s) preenchido(s) com o padrão: ' + faltou.join(', '));
  }
  return guardada;
}

/* ============================================================
   [CFGLIDA] 03/11 16:33 — "configurar porque vai ser tudo
   automático, eu não vou ficar preenchendo".
   Tem razão. A tela de prévia pedia os endereços toda vez, e a
   configuração de verdade estava aqui. Duas fontes para a mesma
   coisa é o que ele proibiu desde o começo.
   Agora a fonte é UMA — esta — e a tela LÊ daqui pelo
   google.script.run, que existe quando a página é servida pelo
   /exec. Nada é digitado duas vezes.
   O que sai daqui é só endereço de imagem e de link. Nenhuma
   senha, nenhum token, nenhum dado de pessoa.
   ============================================================ */
function AP_MAILPED_configuracao() {
  try {
    var c = AP_MAILPED_cfg_();
    return JSON.stringify({
      ok: true,
      empresa: c.empresa, logo: c.logo, fotoObra: c.fotoObra,
      icones: c.icones, link: c.link, obra: c.obra, local: c.local,
      email: c.email, telefone: c.telefone,
      etapasQueEnviam: c.etapasQueEnviam, copiaSempre: c.copiaSempre,
      ligado: c.ligado, abaUsuarios: c.abaUsuarios,
      colGestor: c.colGestor || ''
    });
  } catch (e) {
    return JSON.stringify({ ok: false, mensagem: String(e && e.message) });
  }
}

/** A tela grava a configuração aqui. Só os campos de aparência e
    envio; nada que seja segredo passa por este caminho. */
function AP_MAILPED_salvarConfiguracao(textoJSON) {
  try {
    var novo = JSON.parse(textoJSON || '{}');
    var c;
    try { c = AP_MAILPED_cfg_(); } catch (e) { c = AP_MAILPED_configurar(); }
    var podem = ['empresa', 'logo', 'fotoObra', 'icones', 'link', 'obra',
                 'local', 'email', 'telefone', 'etapasQueEnviam',
                 'copiaSempre', 'ligado', 'abaUsuarios', 'colGestor'];
    podem.forEach(function (k) {
      if (novo[k] !== undefined) c[k] = novo[k];
    });
    PropertiesService.getScriptProperties()
      .setProperty('MAILPED_CFG', JSON.stringify(c));
    return JSON.stringify({ ok: true, mensagem: 'configuração guardada' });
  } catch (e) {
    return JSON.stringify({ ok: false, mensagem: String(e && e.message) });
  }
}

/* ============================================================
   [PREVIAGS] a tela vê o MESMO e-mail, montado aqui
   ------------------------------------------------------------
   A prévia não pode usar cid: — isso só existe dentro do e-mail.
   Mas também não vou duplicar as imagens no HTML: duas cópias da
   mesma coisa é o que ele proibiu. Então a prévia é montada AQUI,
   pelo mesmo código do envio, e na hora de devolver eu troco cada
   cid: por data: — que o navegador mostra e o Gmail não precisa.
   Uma fonte só, e a tela vê exatamente o que vai sair.
   ============================================================ */
function AP_MAILPED_previa(textoJSON) {
  try {
    var pedido = JSON.parse(textoJSON || '{}');
    var cfg = AP_MAILPED_cfg_();
    var html = AP_MAILPED_montar_(pedido, cfg, {});
    /* cid -> data, só para o navegador */
    for (var nome in AP_MAILPED_USADAS) {
      var x = AP_MAILPED_IMAGENS[nome];
      if (!x) continue;
      html = html.split('cid:' + nome).join('data:' + x.t + ';base64,' + x.b);
    }
    return JSON.stringify({ ok: true, html: html,
      assunto: '[ALMOXA PRO] Pedido ' + AP_MAILPED_lp_(pedido.id) + ' · ' +
        AP_MAILPED_ETAPAS[AP_MAILPED_etapaDe_(pedido).indice].rotulo.replace(/<br>/g, ' ') });
  } catch (e) {
    return JSON.stringify({ ok: false, mensagem: String(e && e.message) });
  }
}

/** A tela chama esta para mandar o teste. Devolve texto, porque é
