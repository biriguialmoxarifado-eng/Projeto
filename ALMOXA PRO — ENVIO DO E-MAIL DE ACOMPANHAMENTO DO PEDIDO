/** Liga ou desliga o envio sem mexer no resto da configuração. */
function AP_MAILPED_ligar(sim) {
  var cfg = AP_MAILPED_cfg_();
  cfg.ligado = (sim === true);
  PropertiesService.getScriptProperties()
    .setProperty('MAILPED_CFG', JSON.stringify(cfg));
  Logger.log('ligado = ' + cfg.ligado);
  return cfg.ligado;
}

