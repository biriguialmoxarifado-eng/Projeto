/* ============================================================
   [QUEMPEDIU] 04/11 — A PORTA PARA A TELA
   ------------------------------------------------------------
   A tela de Compras precisa de três coisas, e eu não quero três
   funções públicas novas nem uma rota nova no Core. Uma função
   só, que recebe JSON e devolve JSON, do mesmo jeito que as
   outras que a tela já chama por google.script.run.

     {acao:'jaFalou', id:'#PC-000018'}
         -> {ok:true, etapas:['REGISTRADO']}
         Serve para a tela saber se aquele pedido JÁ teve e-mail.
         Zero etapas = ainda não falei dele = é o primeiro envio,
         e o primeiro, pelo documento dele, é manual.

     {acao:'mandar', pedido:{...}, opcoes:{manual:true}}
         -> {ok:true, enviado:true|false, motivo:'...'}

     {acao:'ligar', sim:true}
         -> {ok:true, ligado:true}
         Só depois que ele confirmar o primeiro, e só se ele pedir.
         Eu não ligo o automático por conta própria.

   Nada aqui envia sozinho. Quem chama é a tela, depois de uma
   gravação que deu certo no Core.
   ============================================================ */
function AP_MAILPED_jaFalou(idPedido) {
  var pre = 'MAILPED:' + AP_MAILPED_lp_(idPedido) + ':';
  var todas = PropertiesService.getScriptProperties().getProperties();
  var etapas = [];
  for (var k in todas) {
    if (k.indexOf(pre) === 0) etapas.push(k.substring(pre.length));
  }
  return etapas;
}

function AP_MAILPED_pelaTela(json) {
  var o = {};
  try { o = JSON.parse(json || '{}') || {}; } catch (e) { o = {}; }
  var acao = AP_MAILPED_lp_(o.acao);
  try {
    if (acao === 'jaFalou') {
      return JSON.stringify({ ok: true, etapas: AP_MAILPED_jaFalou(o.id) });
    }
    if (acao === 'mandar') {
      var r = AP_MAILPED_aoMudarEtapa(o.pedido || {}, o.opcoes || {});
      r.ok = true;
      return JSON.stringify(r);
    }
    if (acao === 'conferirAba') {
      var ca = AP_MAILPED_conferirAba();
      return JSON.stringify({ ok: true, aba: ca });
    }
    if (acao === 'remetente') {
      var rem = AP_MAILPED_remetente_();
      rem.ok = true;
      return JSON.stringify(rem);
    }
    if (acao === 'ligar') {
      AP_MAILPED_ligar(o.sim !== false);
      return JSON.stringify({ ok: true, ligado: o.sim !== false });
    }
    return JSON.stringify({ ok: false, mensagem: 'ação desconhecida: ' + (acao || '(vazia)') });
  } catch (e) {
    /* mesma regra do resto do módulo: e-mail não derruba a tela */
    return JSON.stringify({ ok: false, mensagem: String((e && e.message) || e) });
  }
}
