};

function AP_MAILPED_etapaDe_(pedido) {
  var st = AP_MAILPED_lp_(pedido && pedido.status)
    .toUpperCase().replace(/[\s\-]+/g, '_');
  if (AP_MAILPED_MAPA[st] !== undefined) {
    return { indice: AP_MAILPED_MAPA[st], conhecido: true, status: st };
  }
  return { indice: 0, conhecido: false, status: st || '(sem status)' };
}

/* ============================================================
   3. DE QUEM É O E-MAIL
   ------------------------------------------------------------
   Pela matrícula primeiro. Pelo nome só quando aquele nome
   aparece UMA vez no cadastro: dois homônimos e eu não escolho —
   mandar a movimentação de um para o outro é pior que não mandar.
   ============================================================ */
/* ============================================================
   [CABECALHO] 04/11 — ACHAR A COLUNA SEM EXIGIR O NOME EXATO
   ------------------------------------------------------------
   Isto aqui era indexOf('email') cru. Quer dizer: a planilha
   tinha que ter uma coluna escrita exatamente "email". Se
   estivesse "E-mail", "E-MAIL", "Email " ou "Endereço de e-mail",
   o indexOf devolvia -1 e NENHUM e-mail era achado nunca — sem
   erro na tela, sem aviso, sem nada. O mesmo para "Matrícula"
   com acento e "Nome Completo".
   Agora comparo sem acento, sem maiúscula e sem pontuação, e
   aceito os apelidos que a planilha de RH e a exportação do
   Active Directory costumam usar — a mesma lista do [EMAILCOLAB],
   que já funcionou com a planilha dele.
   O nome configurado continua ganhando: se ele apontou a coluna,
   é a dela que vale.
   ============================================================ */
var AP_MAILPED_APELIDOS = {
  nome:      ['nome', 'nomecompleto', 'colaborador', 'funcionario', 'empregado',
              'displayname', 'nomeexibicao', 'nomedeexibicao', 'cn', 'fullname', 'usuario'],
  email:     ['email', 'emails', 'correio', 'correioeletronico', 'mail',
              'enderecoeletronico', 'enderecodeemail', 'userprincipalname', 'upn',
              'emailaddress', 'primarysmtpaddress', 'smtp'],
  matricula: ['matricula', 'matricul', 'mat', 'chapa', 'registro',
              'employeeid', 'employeenumber']
};

function AP_MAILPED_chaveCol_(t) {
  return String(t || '')
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .toLowerCase().replace(/[^a-z0-9]/g, '');
}

function AP_MAILPED_acharColuna_(cab, configurado, tipo) {
  var normal = [];
  for (var i = 0; i < cab.length; i++) normal.push(AP_MAILPED_chaveCol_(cab[i]));

  /* 1º o que ELE configurou — se apontou a coluna, é ela */
  var alvo = AP_MAILPED_chaveCol_(configurado);
  if (alvo) {
    var j = normal.indexOf(alvo);
    if (j > -1) return j;
  }
  /* 2º os apelidos conhecidos, em ordem de preferência */
  var lista = AP_MAILPED_APELIDOS[tipo] || [];
  for (var k = 0; k < lista.length; k++) {
    var p = normal.indexOf(lista[k]);
    if (p > -1) return p;
  }
  return -1;
}

/** Diz quais colunas da aba de usuários o módulo está enxergando. */
function AP_MAILPED_conferirAba() {
  var cfg = AP_MAILPED_cfg_();
  var aba = SpreadsheetApp.getActive().getSheetByName(cfg.abaUsuarios);
  if (!aba) {
    return { ok: false, aba: cfg.abaUsuarios,
             motivo: 'não existe aba chamada "' + cfg.abaUsuarios + '" nesta planilha' };
  }
  var dados = aba.getDataRange().getValues();
  if (!dados.length) return { ok: false, aba: cfg.abaUsuarios, motivo: 'a aba está vazia' };
  var cab = dados[0].map(function (c) { return String(c || '').toLowerCase().trim(); });
  var iNome = AP_MAILPED_acharColuna_(cab, cfg.colNome, 'nome');
  var iMail = AP_MAILPED_acharColuna_(cab, cfg.colEmail, 'email');
  var iMat  = AP_MAILPED_acharColuna_(cab, cfg.colMatricula, 'matricula');

  var comEmail = 0;
  for (var i = 1; i < dados.length && iMail >= 0; i++) {
    if (AP_MAILPED_emailValido_(AP_MAILPED_lp_(dados[i][iMail]))) comEmail++;
  }
  return {
    ok: iNome >= 0 && iMail >= 0,
    aba: cfg.abaUsuarios,
    cabecalhos: cab,
    linhas: Math.max(0, dados.length - 1),
    colunaNome: iNome >= 0 ? cab[iNome] : '',
    colunaEmail: iMail >= 0 ? cab[iMail] : '',
    colunaMatricula: iMat >= 0 ? cab[iMat] : '',
    comEmailValido: comEmail,
    motivo: iNome < 0 || iMail < 0
      ? 'não achei coluna de ' + (iNome < 0 ? 'nome ' : '') + (iMail < 0 ? 'e-mail' : '')
      : ''
  };
}

function AP_MAILPED_acharEmail_(pedido) {
  var cfg = AP_MAILPED_cfg_();
  var mat = AP_MAILPED_chaveMat_(pedido && (pedido.matricula || pedido.matriculaSolicitante));
  var cru = AP_MAILPED_lp_(pedido && (pedido.solicitante || pedido.nome));
  var nome = AP_MAILPED_chaveNome_(cru);

  /* [EMAILNOCAMPO] 04/11 — o módulo compras do Core dele grava no
     solicitante o E-MAIL da conta que está logada, não o nome.
     Então chegava aqui "Ismael.Santos@coesa.com.br" e eu procurava
     uma PESSOA com esse nome na planilha, não achava, e dizia
     "nenhum cadastro com e-mail para esta pessoa" — com o endereço
     da pessoa escrito na minha frente.
     Se o campo já é um endereço, ele é o endereço. Isso não é
     inventar e-mail: é o Core dizendo qual é. */
  if (AP_MAILPED_emailValido_(cru)) {
    return { ok: true, email: cru, via: 'o próprio pedido traz o endereço' };
  }

  if (!mat && !nome) {
    return { ok: false, motivo: 'o pedido não diz de quem é (sem matrícula e sem nome)' };
  }

  var aba = SpreadsheetApp.getActive().getSheetByName(cfg.abaUsuarios);
  if (!aba) {
    return { ok: false, motivo: 'não achei a aba "' + cfg.abaUsuarios + '"' };
  }
  var dados = aba.getDataRange().getValues();
  if (dados.length < 2) return { ok: false, motivo: 'a aba de usuários está vazia' };

  var cab = dados[0].map(function (c) {
    return String(c || '').toLowerCase().trim();
  });
  var iNome = AP_MAILPED_acharColuna_(cab, cfg.colNome, 'nome');
  var iMail = AP_MAILPED_acharColuna_(cab, cfg.colEmail, 'email');
  var iMat  = AP_MAILPED_acharColuna_(cab, cfg.colMatricula, 'matricula');
  if (iNome < 0 || iMail < 0) {
    return { ok: false, motivo: 'a aba "' + cfg.abaUsuarios + '" não tem coluna de ' +
      (iNome < 0 ? 'nome' : '') + (iNome < 0 && iMail < 0 ? ' nem de ' : '') +
      (iMail < 0 ? 'e-mail' : '') + '. Os cabeçalhos que achei: ' + cab.join(' | ') };
  }

  var porMat = [], porNome = [];
  for (var i = 1; i < dados.length; i++) {
    var l = dados[i];
    var e = AP_MAILPED_lp_(l[iMail]);
    if (!e) continue;
    if (iMat >= 0 && mat && AP_MAILPED_chaveMat_(l[iMat]) === mat) {
      porMat.push({ email: e, nome: AP_MAILPED_lp_(l[iNome]) });
    } else if (nome && AP_MAILPED_chaveNome_(l[iNome]) === nome) {
      porNome.push({ email: e, nome: AP_MAILPED_lp_(l[iNome]) });
    }
  }

  if (porMat.length === 1) return { ok: true, email: porMat[0].email, via: 'matrícula' };
  if (porMat.length > 1) {
    return { ok: false, motivo: porMat.length + ' cadastros com a matrícula ' +
      mat + ' — não escolho' };
  }
  if (porNome.length === 1) return { ok: true, email: porNome[0].email, via: 'nome completo' };
  if (porNome.length > 1) {
    return { ok: false, motivo: porNome.length +
      ' pessoas com este nome e e-mails diferentes — não escolho' };
  }
  return { ok: false, motivo: 'nenhum cadastro com e-mail para esta pessoa' };
}

/* ============================================================
   3b. [GESTOR] O GESTOR DE QUEM PEDIU
   ------------------------------------------------------------
   "Vai seguir a linha de quem solicitou: se a pessoa for
   subordinada de outra, copia o gestor."
   Eu não invento organograma. Leio a coluna que ele apontar em
   cfg.colGestor, na mesma aba de usuários. O que estiver lá pode
   ser o e-mail do gestor (uso direto) ou o nome completo dele
   (procuro o e-mail pelo nome, e só aceito se for único).
   Sem coluna, sem valor, ou nome repetido: ninguém é copiado, e o
   motivo fica registrado — nunca copio alguém no palpite.
   ============================================================ */
function AP_MAILPED_gestorDe_(pedido) {
  var cfg = AP_MAILPED_cfg_();
  var col = AP_MAILPED_lp_(cfg.colGestor);
  if (!col) return { email: '', motivo: 'nenhuma coluna de gestor configurada' };

  var aba = SpreadsheetApp.getActive().getSheetByName(cfg.abaUsuarios);
  if (!aba) return { email: '', motivo: 'não achei a aba de usuários' };
  var dados = aba.getDataRange().getValues();
  if (dados.length < 2) return { email: '', motivo: 'aba vazia' };

  var cab = dados[0].map(function (c) { return String(c || '').toLowerCase().trim(); });
  /* [CABECALHO] 04/11 — aqui era o mesmo indexOf cru da outra
     função; se o cabeçalho tiver acento ou maiúscula, o gestor
     nunca seria encontrado e ninguém seria copiado, em silêncio. */
  var iNome = AP_MAILPED_acharColuna_(cab, cfg.colNome, 'nome');
  var iMail = AP_MAILPED_acharColuna_(cab, cfg.colEmail, 'email');
  var iMat  = AP_MAILPED_acharColuna_(cab, cfg.colMatricula, 'matricula');
  var iGes  = AP_MAILPED_acharColuna_(cab, col, 'gestor');
  if (iGes < 0) return { email: '', motivo: 'a aba não tem a coluna "' + col + '"' };

  var mat = AP_MAILPED_chaveMat_(pedido && (pedido.matricula || pedido.matriculaSolicitante));
  var nome = AP_MAILPED_chaveNome_(pedido && (pedido.solicitante || pedido.nome));

  /* a linha de quem pediu */
  var linha = null;
  for (var i = 1; i < dados.length; i++) {
    var l = dados[i];
    if (iMat >= 0 && mat && AP_MAILPED_chaveMat_(l[iMat]) === mat) { linha = l; break; }
  }
  if (!linha && nome) {
    var achadas = [];
    for (var j = 1; j < dados.length; j++) {
      if (AP_MAILPED_chaveNome_(dados[j][iNome]) === nome) achadas.push(dados[j]);
    }
    if (achadas.length === 1) linha = achadas[0];
    else if (achadas.length > 1) {
      return { email: '', motivo: 'nome de quem pediu aparece mais de uma vez — não escolho' };
    }
  }
  if (!linha) return { email: '', motivo: 'não achei a linha de quem pediu' };

  var valor = AP_MAILPED_lp_(linha[iGes]);
  if (!valor) return { email: '', motivo: 'esta pessoa não tem gestor preenchido' };

  /* já é e-mail? */
  if (AP_MAILPED_emailValido_(valor)) {
    return { email: valor, motivo: 'e-mail do gestor na própria coluna' };
  }

  /* é nome: procuro o e-mail dele, e só aceito se for único */
  var alvo = AP_MAILPED_chaveNome_(valor), achados = [];
  for (var k = 1; k < dados.length; k++) {
    if (AP_MAILPED_chaveNome_(dados[k][iNome]) === alvo) {
      var e = AP_MAILPED_lp_(dados[k][iMail]);
      if (e && AP_MAILPED_emailValido_(e)) achados.push(e);
    }
  }
  if (achados.length === 1) return { email: achados[0], motivo: 'gestor achado pelo nome' };
  if (achados.length > 1) {
    return { email: '', motivo: 'mais de um cadastro com o nome do gestor — não escolho' };
  }
  return { email: '', motivo: 'o gestor "' + valor + '" não tem e-mail no cadastro' };
}

/* ============================================================
   4. A TRAVA DE DUPLICIDADE
   ------------------------------------------------------------
   "Enviar somente em eventos configurados e evitar duplicidade."
   Guardo pedido+etapa. Se o Core chamar duas vezes a mesma coisa
   — e vai chamar, porque toda tela que salva mexe no status — o
   segundo não sai.
   ============================================================ */
function AP_MAILPED_jaMandou_(idPedido, etapa) {
  var k = 'MAILPED:' + idPedido + ':' + etapa;
  return !!PropertiesService.getScriptProperties().getProperty(k);
}
function AP_MAILPED_marcar_(idPedido, etapa) {
  var k = 'MAILPED:' + idPedido + ':' + etapa;
  PropertiesService.getScriptProperties()
    .setProperty(k, new Date().toISOString());
}
/** Apaga a trava de um pedido — para reenviar de propósito. */
function AP_MAILPED_destravar(idPedido) {
  var pr = PropertiesService.getScriptProperties();
  var todas = pr.getProperties();
  var n = 0;
  for (var k in todas) {
    if (k.indexOf('MAILPED:' + idPedido + ':') === 0) { pr.deleteProperty(k); n++; }
  }
  Logger.log('destravei ' + n + ' etapa(s) do pedido ' + idPedido);
  return n;
}

/* ============================================================
   5. A PORTA — é esta que você chama no seu fluxo
   ============================================================ */
/**
 * Chame onde o status do pedido muda.
 *   AP_MAILPED_aoMudarEtapa(pedido);
 * pedido: o objeto que você já tem, com id, status, solicitante,
 *         fornecedor, itens/descricao, qtd e historico.
 * Devolve {ok, enviado, motivo} e NUNCA lança erro para cima:
 * e-mail não pode derrubar o lançamento do pedido.
 */
function AP_MAILPED_aoMudarEtapa(pedido, opcoes) {
  try {
    var cfg = AP_MAILPED_cfg_();
    var o = opcoes || {};
    var id = AP_MAILPED_lp_(pedido && pedido.id);
    if (!id) return AP_MAILPED_fim_(false, 'o pedido não tem id');

    var et = AP_MAILPED_etapaDe_(pedido);
    var chave = AP_MAILPED_ETAPAS[et.indice].chave;

    /* [QUEMPEDIU] 04/11 — o documento dele separa duas coisas:
       "o primeiro envio será manual, após conferência e confirmação
       do usuário" (módulo 3) e só depois o automático (módulo 4).
       o.manual é o primeiro: ele olhou na tela e apertou. Esse passa
       mesmo com o automático desligado — mas continua respeitando a
       trava de duplicidade e continua marcando que já foi, senão o
       automático repetiria a mesma etapa depois. o.forcar continua
       sendo o que era: teste, não marca nada. */
    if (!cfg.ligado && !o.forcar && !o.manual) {
      return AP_MAILPED_fim_(false,
        'o envio automático está desligado — rode AP_MAILPED_ligar(true) quando quiser ligar. ' +
        'O botão de teste da tela funciona do mesmo jeito.');
    }
    if (cfg.etapasQueEnviam.indexOf(chave) < 0) {
      return AP_MAILPED_fim_(false, 'a etapa ' + chave + ' não está na lista que envia');
    }
    if (AP_MAILPED_jaMandou_(id, chave) && !o.forcar) {
      return AP_MAILPED_fim_(false, 'já mandei o pedido ' + id + ' na etapa ' + chave);
    }

    /* [UMAFONTE] 04/11 — a tela já achou o e-mail no CADASTRO
       OFICIAL (usuarios.listar) antes de chamar. Ele mandar esse
       endereço junto evita que eu vá procurar DE NOVO, na planilha,
       e possivelmente ache outra coisa: duas fontes para o mesmo
       dado é o que ele proibiu. Diferente de o.para, que é teste:
       emailSolicitante é envio de verdade e continua copiando o
       gestor normalmente. */
    var quem;
    if (o.para) {
      quem = { ok: true, email: o.para, via: 'informado na chamada' };
    } else if (AP_MAILPED_emailValido_(AP_MAILPED_lp_(o.emailSolicitante))) {
      quem = { ok: true, email: AP_MAILPED_lp_(o.emailSolicitante),
               via: 'cadastro oficial, resolvido pela tela' };
    } else {
      quem = AP_MAILPED_acharEmail_(pedido);
    }
    if (!quem.ok) return AP_MAILPED_fim_(false, quem.motivo);
    if (!AP_MAILPED_emailValido_(quem.email)) {
      return AP_MAILPED_fim_(false, 'o endereço achado não parece e-mail');
    }

    var copia = (cfg.copiaSempre || []).filter(AP_MAILPED_emailValido_);
    var ges = { email: '', motivo: 'não procurei (envio de teste)' };
    if (!o.para) {
      try { ges = AP_MAILPED_gestorDe_(pedido); } catch (eg) {
        ges = { email: '', motivo: 'falhou: ' + (eg && eg.message) };
      }
      if (ges.email && copia.indexOf(ges.email) < 0 && ges.email !== quem.email) {
        copia.push(ges.email);
      }
    }
    var html = AP_MAILPED_montar_(pedido, cfg, o);
    var assunto = '[ALMOXA PRO] Pedido ' + id + ' · ' +
      AP_MAILPED_ETAPAS[et.indice].rotulo.replace(/<br>/g, ' ');

    /* [MAILIMG] só as imagens que o corpo realmente usou viajam
       junto — mandar as 26 em todo e-mail seria peso à toa */
    var embutidas = {}, quantas = 0;
    for (var nm in AP_MAILPED_USADAS) {
      var bl = AP_MAILPED_blob_(nm);
      if (bl) { embutidas[nm] = bl; quantas++; }
    }

    /* [REMETENTE] 04/11 — o noReply que estava aqui saiu de
       propósito: ele força o endereço de não-responder e CANCELA
       qualquer resposta. Ele quer o contrário — quem receber tem
       que conseguir responder para o almoxarifado. */
    var rem = AP_MAILPED_remetente_();
    AP_MAILPED_enviar_(rem, quem.email, copia, assunto, html,
                       quantas ? embutidas : null);

    if (!o.forcar) AP_MAILPED_marcar_(id, chave);
    /* no registro vai o id, a etapa e o domínio — nunca o endereço
       inteiro, que é dado pessoal e não precisa estar no log */
    Logger.log('enviado · ' + id + ' · ' + chave + ' · via ' + quem.via +
               ' · @' + String(quem.email).split('@')[1] +
               ' · cópia: ' + copia.length + ' (' + ges.motivo + ')' +
               ' · ' + quantas + ' imagem(ns) embutida(s)' +
               ' · remetente: ' + rem.como);
    return AP_MAILPED_fim_(true, 'enviado na etapa ' + chave,
      { etapa: chave, via: quem.via, copias: copia.length, gestor: ges.motivo,
        remetente: rem });

  } catch (e) {
    /* e-mail nunca derruba o lançamento */
    Logger.log('[MAILPED] falhou: ' + (e && e.message));
    return AP_MAILPED_fim_(false, 'falhou: ' + (e && e.message));
  }
}

function AP_MAILPED_fim_(enviado, motivo, extra) {
  var r = { ok: true, enviado: !!enviado, motivo: motivo || '' };
  if (extra) for (var k in extra) r[k] = extra[k];
  if (!enviado) Logger.log('[MAILPED] não enviei: ' + motivo);
  return r;
}

/* ============================================================
   [REMETENTE] 04/11 — DE QUEM O E-MAIL PARECE VIR
   ------------------------------------------------------------
   "quem enviou foi o Ismael, ismael.santos@coesa.com.br".
   Isto aqui descobre, na hora do envio, o que o Google realmente
   permite — e devolve a verdade, não o desejo. Três casos:

     propria   o endereço configurado É a conta que roda o script.
     alias     é um alias dela; o Gmail assina com ele.
     resposta  não é nem um nem outro. Sai pela conta dona, com o
               nome configurado, e a RESPOSTA vai para o endereço
               configurado. É o máximo que existe, e é honesto:
               quem responder, responde para o almoxarifado.

   Nunca invento o terceiro caso como se fosse o primeiro. Se eu
   escrevesse o endereço dele no "De:" sem ser dono nem alias, o
   Google ou recusa, ou entrega marcado como suspeito, e aí o
   e-mail de pedido cai no spam da obra inteira.
   ============================================================ */
function AP_MAILPED_remetente_() {
  var cfg = AP_MAILPED_cfg_();
  var querido = AP_MAILPED_lp_(cfg.remetente).toLowerCase();
  var nome = AP_MAILPED_lp_(cfg.remetenteNome) || AP_MAILPED_lp_(cfg.empresa);

  var dono = '';
  try { dono = AP_MAILPED_lp_(Session.getEffectiveUser().getEmail()); } catch (e) { dono = ''; }

  if (!querido) {
    return { como: 'conta', de: dono, nome: nome, responderPara: '',
             texto: 'nenhum remetente configurado — sai pela conta do script' };
  }
  if (dono && querido === dono.toLowerCase()) {
    return { como: 'propria', de: dono, nome: nome, responderPara: '',
             texto: 'sai como ' + dono + ' — é a própria conta que roda o script' };
  }

  var aliases = [];
  try { aliases = GmailApp.getAliases() || []; } catch (e) { aliases = []; }
  for (var i = 0; i < aliases.length; i++) {
    if (AP_MAILPED_lp_(aliases[i]).toLowerCase() === querido) {
      return { como: 'alias', de: AP_MAILPED_lp_(cfg.remetente), nome: nome, responderPara: '',
               texto: 'sai como ' + cfg.remetente + ' — é um alias desta conta' };
    }
  }

  return {
    como: 'resposta', de: dono, nome: nome, responderPara: AP_MAILPED_lp_(cfg.remetente),
    texto: '"' + cfg.remetente + '" não é a conta que roda o script nem um alias dela, ' +
           'e o Google não deixa escrever esse endereço no "De:". ' +
           'O e-mail sai por ' + (dono || 'a conta do script') + ' assinado como "' + nome +
           '", e quem responder responde para ' + cfg.remetente + '. ' +
           'Para o "De:" virar o seu endereço, ele precisa ser adicionado como alias ' +
           'da conta do script (Gmail › Configurações › Contas › Enviar e-mail como).'
  };
}

/* o único lugar do módulo que fala com o Gmail */
function AP_MAILPED_enviar_(rem, para, copias, assunto, html, embutidas) {
  var cc = (copias && copias.length) ? copias.join(',') : '';

  if (rem.como === 'alias') {
    /* só o GmailApp aceita "from", e só com alias de verdade */
    GmailApp.sendEmail(para, assunto, '', {
      htmlBody: html,
      cc: cc || undefined,
      inlineImages: embutidas || undefined,
      from: rem.de,
      name: rem.nome,
      replyTo: rem.de
    });
    return rem;
  }

  MailApp.sendEmail({
    to: para,
    cc: cc || undefined,
    subject: assunto,
    htmlBody: html,
    inlineImages: embutidas || undefined,
    name: rem.nome,
    replyTo: rem.responderPara || undefined
  });
  return rem;
}

