# ============================================================
#  ALMOXA PRO V2 — configuração local
# ------------------------------------------------------------
#  Copie este arquivo para .env e preencha.
#  O .env fica fora do Git (ver .gitignore).
#
#  Para subir o servidor com estas variáveis:
#      npm run start:local
#
#  Sem ALMOXA_SQLITE_PATH o servidor sobe, imprime
#  "disponível na porta 3000" e devolve 404 em tudo —
#  porque não há banco para o diagnóstico consultar.
# ============================================================


# --- Banco local (SQLite) --------------------------------------------------
# Caminho do arquivo do banco. É o que liga o diagnóstico e o Core isolado.
# Guarde FORA do repositório. A pasta precisa existir.
ALMOXA_SQLITE_PATH=C:\ALMOXA\dados\almoxa.db


# --- Credencial do diagnóstico ---------------------------------------------
# Token: no mínimo 32 caracteres, sem espaços. Gere um aleatório.
#   Windows PowerShell:
#     [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
ALMOXA_DIAGNOSTICS_TOKEN=troque-por-um-token-aleatorio-de-32-ou-mais

# Quem responde pelas operações de diagnóstico. Até 80 caracteres.
ALMOXA_DIAGNOSTICS_ACTOR=seu.nome

# Papel: reader (só leitura) ou operator (leitura e escrita).
ALMOXA_DIAGNOSTICS_ROLE=operator


# --- Rede ------------------------------------------------------------------
PORT=3000
# Mantenha 127.0.0.1 enquanto for uso local. A homologação com planilha
# de teste EXIGE loopback e recusa qualquer outro endereço.
HOST=127.0.0.1


# --- Identificação da versão (opcional) ------------------------------------
# Aparece no diagnóstico. Útil para saber qual build está no ar.
# ALMOXA_REVISION=


# ============================================================
#  Abaixo: só para homologação com Google Sheets.
#  Deixe comentado enquanto estiver trabalhando no banco local.
# ============================================================

# Planilha de TESTE usada na homologação. Nunca a planilha de produção.
# Preencha para abrir o Desktop pelo Core V2, em /homologacao/desktop.
# Veja database/docs/V431_DESKTOP_NO_CORE_V2.md
# ALMOXA_PREVIEW_SHEET_ID=

# Perfil de aprovação aplicado na homologação.
# ALMOXA_PREVIEW_APPROVAL_PROFILE=

# 1 libera escrita na homologação. Em branco, só leitura.
# ALMOXA_PREVIEW_WRITE=

# Planilha e credencial para os testes contra o Google real.
# ALMOXA_SPREADSHEET_ID=
# ALMOXA_GOOGLE_AUTH=
# ALMOXA_TEST_SPREADSHEET_ID=
# ALMOXA_TEST_DRIVE_FILE_ID=
